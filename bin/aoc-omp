#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"


usage() {
  cat <<'EOF'
Usage: aoc-omp [OMP_ARGS...]

Launch OMP with the compact AOC startup capsule appended to the system prompt.
The capsule is metadata-only: it reports project/task/tool policy without broad
project-context or raw task-state injection.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi


raw_omp="${AOC_RAW_OMP_BIN:-}"
if [[ -z "$raw_omp" ]]; then
  if command -v omp-raw >/dev/null 2>&1; then
    raw_omp="omp-raw"
  else
    raw_omp="omp"
  fi
fi
if ! command -v "$raw_omp" >/dev/null 2>&1; then
  if [[ -n "${AOC_RAW_OMP_BIN:-}" ]]; then
    echo "aoc-omp: raw OMP binary not found: $raw_omp" >&2
  else
    echo "aoc-omp: OMP is not installed or not on PATH" >&2
  fi
  exit 1
fi
if [[ -z "${PI_PACKAGE_DIR:-}" && -d "$HOME/.cache/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent" ]]; then
  export PI_PACKAGE_DIR="$HOME/.cache/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent"
fi


case "${1:-}" in
  __complete|acp|agents|auth-broker|auth-gateway|bench|cleanse|commit|completions|config|dry-balance|gallery|gc|grep|grievances|help|install|join|models|plugin|q|read|say|search|setup|shell|ssh|stats|tiny-models|token|ttsr|update|usage|worktree|wt|--version|-V|version)
    exec "$raw_omp" "$@"
    ;;
esac

has_explicit_skills=0
for arg in "$@"; do
  case "$arg" in
    --skills|--skills=*|--no-skills)
      has_explicit_skills=1
      break
      ;;
  esac
done

skill_args=()
if [[ "$has_explicit_skills" -eq 0 ]]; then
  if [[ -x "$script_dir/aoc-profile" ]]; then
    profile_bin="$script_dir/aoc-profile"
  elif command -v aoc-profile >/dev/null 2>&1; then
    profile_bin="aoc-profile"
  else
    echo "aoc-omp: aoc-profile not found; refusing to launch without an explicit --skills allowlist" >&2
    exit 1
  fi

  profile_err="$(mktemp "${TMPDIR:-/tmp}/aoc-omp-profile.XXXXXX.err")"
  if ! active_skills="$("$profile_bin" active --kind skills 2>"$profile_err")"; then
    profile_diag="$(<"$profile_err")"
    rm -f "$profile_err"
    echo "aoc-omp: failed to resolve active skills: $profile_diag" >&2
    exit 1
  fi
  rm -f "$profile_err"

  skill_csv=""
  declare -A seen_skills=()
  while IFS= read -r skill; do
    [[ -n "$skill" ]] || continue
    [[ -z "${seen_skills[$skill]:-}" ]] || continue
    seen_skills[$skill]=1
    if [[ -n "$skill_csv" ]]; then
      skill_csv+=","
    fi
    skill_csv+="$skill"
  done <<<"$active_skills"
  if [[ -n "$skill_csv" ]]; then
    skill_args=(--skills "$skill_csv")
  else
    skill_args=(--no-skills)
  fi
fi

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
mkdir -p "$runtime_dir"
capsule="$(mktemp "$runtime_dir/aoc-omp-context.XXXXXX.md")"
aoc-omp-context > "$capsule"

exec "$raw_omp" --append-system-prompt "$capsule" "${skill_args[@]}" "$@"
