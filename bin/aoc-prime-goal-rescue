#!/usr/bin/env bun

import { createHash, randomUUID } from "node:crypto";
import {
  constants as fsConstants,
  createReadStream,
  existsSync,
  readFileSync,
  realpathSync,
  statSync,
} from "node:fs";
import { appendFile, copyFile, open } from "node:fs/promises";
import { createInterface } from "node:readline";
import { dirname, join, resolve } from "node:path";
import { pathToFileURL } from "node:url";

const DEFAULT_KEEP_TOKENS = 20_000;
const RESCUE_CONTEXT_WINDOW = 272_000;
const RESCUE_MAX_CONTEXT_TOKENS = 60_000;
const FALLBACK_PRIME_AGENT_PACKAGE =
  "/home/ceii/.local/share/mise/installs/node/26.1.0/lib/node_modules/prime-agent";

const HELP = `Usage: aoc-prime-goal-rescue <session.jsonl> [--keep-tokens 20000] [--dry-run]

Offline repair for a goal-mode prime-agent session stuck in a compaction freeze.
The session must not be running. The tool streams and validates the JSONL, walks
its current branch, carries forward the latest compaction summary, and appends a
corrected compaction entry. A timestamped .bak copy is created before any write.

Options:
  --keep-tokens N  target recent message content to retain (default: 20000)
  --dry-run        print the proposed repair without writing or creating a backup
  -h, --help       show this help

Safety:
  A live prime-agent session lease causes a hard refusal. Exit the prime-agent
  TUI to release its lease, then run this command again.
`;

function parseArgs(argv) {
  if (argv.includes("--help") || argv.includes("-h")) {
    console.log(HELP);
    process.exit(0);
  }

  let sessionPath;
  let keepTokens = DEFAULT_KEEP_TOKENS;
  let dryRun = false;

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--dry-run") {
      dryRun = true;
      continue;
    }
    if (arg === "--keep-tokens") {
      const value = argv[++i];
      if (value === undefined) {
        throw new Error("--keep-tokens requires a positive integer");
      }
      keepTokens = Number(value);
      continue;
    }
    if (arg.startsWith("--keep-tokens=")) {
      keepTokens = Number(arg.slice("--keep-tokens=".length));
      continue;
    }
    if (arg.startsWith("-")) {
      throw new Error(`Unknown option: ${arg}`);
    }
    if (sessionPath) {
      throw new Error("Exactly one session.jsonl path is required");
    }
    sessionPath = arg;
  }

  if (!sessionPath) {
    throw new Error("A session.jsonl path is required");
  }
  if (!Number.isSafeInteger(keepTokens) || keepTokens <= 0) {
    throw new Error("--keep-tokens must be a positive integer");
  }

  return { sessionPath: resolve(sessionPath), keepTokens, dryRun };
}

function findPrimeAgentPackage() {
  const executable = Bun.which("prime-agent");
  if (executable) {
    const packageRoot = dirname(dirname(dirname(realpathSync(executable))));
    if (existsSync(join(packageRoot, "dist/core/session-manager.js"))) {
      return packageRoot;
    }
  }
  if (existsSync(join(FALLBACK_PRIME_AGENT_PACKAGE, "dist/core/session-manager.js"))) {
    return FALLBACK_PRIME_AGENT_PACKAGE;
  }
  throw new Error("Cannot locate prime-agent dist/core modules");
}

async function loadPiHelpers() {
  const packageRoot = findPrimeAgentPackage();
  const core = join(packageRoot, "dist/core");
  const sessionManager = await import(pathToFileURL(join(core, "session-manager.js")).href);
  const compaction = await import(pathToFileURL(join(core, "compaction/compaction.js")).href);
  const messages = await import(pathToFileURL(join(core, "messages.js")).href);
  const lease = await import(pathToFileURL(join(core, "session-lease.js")).href);
  const config = await import(pathToFileURL(join(packageRoot, "dist/config.js")).href);

  return {
    packageRoot,
    buildSessionContext: sessionManager.buildSessionContext,
    estimateContextTokens: compaction.estimateContextTokens,
    estimateTokens: compaction.estimateTokens,
    findTurnStartIndex: compaction.findTurnStartIndex,
    shouldCompact: compaction.shouldCompact,
    compactionSettings: compaction.DEFAULT_COMPACTION_SETTINGS,
    createCustomMessage: messages.createCustomMessage,
    canonicalSessionPath: lease.canonicalSessionPath,
    getProcessStartId: lease.getProcessStartId,
    getAgentDir: config.getAgentDir,
  };
}

function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error?.code === "EPERM";
  }
}

function getLiveLease(sessionPath, pi) {
  const canonicalPath = pi.canonicalSessionPath(sessionPath);
  const key = createHash("sha256").update(canonicalPath).digest("hex");
  const leaseDirectory = join(pi.getAgentDir(), "session-leases", `${key}.lock`);
  let owner;

  try {
    owner = JSON.parse(readFileSync(join(leaseDirectory, "owner.json"), "utf8"));
  } catch {
    return null;
  }

  if (
    owner?.version !== 1 ||
    typeof owner.token !== "string" ||
    !Number.isInteger(owner.pid) ||
    typeof owner.sessionPath !== "string" ||
    typeof owner.createdAt !== "string"
  ) {
    return null;
  }
  if (owner.sessionPath !== canonicalPath || !processIsAlive(owner.pid)) {
    return null;
  }
  if (owner.processStartId) {
    const currentStartId = pi.getProcessStartId(owner.pid);
    if (currentStartId !== undefined && currentStartId !== owner.processStartId) {
      return null;
    }
  }

  return { ...owner, leaseDirectory, canonicalPath };
}

function assertNoLiveLease(sessionPath, pi) {
  const lease = getLiveLease(sessionPath, pi);
  if (!lease) return;
  const owner = lease.activeSessionId ? ` (${lease.activeSessionId})` : "";
  throw new Error(
    `Live prime-agent session lease detected${owner}: ${lease.canonicalPath}\n` +
      "Exit the prime-agent TUI to release it before running this offline rescue.",
  );
}

async function streamSession(sessionPath) {
  const entries = [];
  const byId = new Map();
  const lineById = new Map();
  let lineNumber = 0;
  let headerCount = 0;

  const lines = createInterface({
    input: createReadStream(sessionPath, { encoding: "utf8" }),
    crlfDelay: Infinity,
  });

  for await (const line of lines) {
    lineNumber++;
    if (!line.trim()) {
      throw new Error(`Blank JSONL line at ${lineNumber}`);
    }

    let entry;
    try {
      entry = JSON.parse(line);
    } catch (error) {
      throw new Error(`Invalid JSON at line ${lineNumber}: ${error.message}`);
    }
    if (!entry || typeof entry !== "object" || typeof entry.type !== "string") {
      throw new Error(`Invalid session entry at line ${lineNumber}`);
    }

    entries.push(entry);
    if (entry.type === "session") {
      headerCount++;
      continue;
    }
    if (typeof entry.id !== "string" || entry.id.length === 0) {
      throw new Error(`Entry at line ${lineNumber} has no id`);
    }
    if (byId.has(entry.id)) {
      throw new Error(`Duplicate entry id ${entry.id} at line ${lineNumber}`);
    }
    byId.set(entry.id, entry);
    lineById.set(entry.id, lineNumber);
  }

  if (headerCount !== 1) {
    throw new Error(`Expected one session header; found ${headerCount}`);
  }
  const leaf = [...entries].reverse().find((entry) => entry.type !== "session");
  if (!leaf) {
    throw new Error("Session has no branch entries");
  }

  const branch = [];
  const visited = new Set();
  let current = leaf;
  while (current) {
    if (visited.has(current.id)) {
      throw new Error(`Cycle in current branch at entry ${current.id}`);
    }
    visited.add(current.id);
    branch.push(current);
    if (!current.parentId) break;
    current = byId.get(current.parentId);
    if (!current) {
      throw new Error(`Missing parent ${branch.at(-1).parentId} for entry ${branch.at(-1).id}`);
    }
  }
  branch.reverse();

  return { entries, byId, lineById, lineCount: lineNumber, leaf, branch };
}

function entryMessage(entry, pi) {
  if (entry.type === "message") return entry.message;
  if (entry.type === "custom_message") {
    return pi.createCustomMessage(
      entry.customType,
      entry.content,
      entry.display,
      entry.details,
      entry.timestamp,
    );
  }
  return undefined;
}

function chooseInitialKeepPoint(branch, keepTokens, pi) {
  let accumulatedTokens = 0;
  let thresholdIndex = -1;

  for (let i = branch.length - 1; i >= 0; i--) {
    const message = entryMessage(branch[i], pi);
    if (!message) continue;
    accumulatedTokens += pi.estimateTokens(message);
    if (accumulatedTokens >= keepTokens) {
      thresholdIndex = i;
      break;
    }
  }

  if (thresholdIndex === -1) {
    thresholdIndex = branch.findIndex((entry) => entryMessage(entry, pi));
  }
  if (thresholdIndex === -1) {
    throw new Error("Current branch contains no model-context messages");
  }

  const turnStartIndex = pi.findTurnStartIndex(branch, thresholdIndex, 0);
  return {
    thresholdIndex,
    keepIndex: turnStartIndex >= 0 ? turnStartIndex : thresholdIndex,
    accumulatedTokens,
  };
}

function validTurnBoundaries(branch, initialIndex, pi) {
  const boundaries = new Set([initialIndex]);
  for (let i = initialIndex + 1; i < branch.length; i++) {
    if (!entryMessage(branch[i], pi)) continue;
    const turnStart = pi.findTurnStartIndex(branch, i, 0);
    if (turnStart >= initialIndex) boundaries.add(turnStart);
    else if (branch[i].type === "message" && branch[i].message?.role === "assistant") {
      boundaries.add(i);
    }
  }
  return [...boundaries].sort((a, b) => a - b);
}

function normalizeSnippet(value) {
  return String(value).replace(/\s+/g, " ").trim();
}

function clip(value, maxLength) {
  const text = normalizeSnippet(value);
  return text.length <= maxLength ? text : `${text.slice(0, maxLength - 1)}…`;
}

function evenlySpaced(items, count) {
  if (items.length <= count) return items;
  if (count === 1) return [items.at(-1)];
  const selected = [];
  for (let i = 0; i < count; i++) {
    selected.push(items[Math.round((i * (items.length - 1)) / (count - 1))]);
  }
  return selected;
}

function buildDigest(elidedEntries) {
  const assistantText = [];
  const toolCalls = [];
  const seen = new Set();

  for (let index = 0; index < elidedEntries.length; index++) {
    const entry = elidedEntries[index];
    if (entry.type !== "message" || entry.message?.role !== "assistant") continue;
    for (const block of entry.message.content ?? []) {
      let line;
      if (block.type === "text" && normalizeSnippet(block.text).length >= 24) {
        line = `Assistant record: ${clip(block.text, 160)}`;
      } else if (block.type === "toolCall") {
        const args = clip(JSON.stringify(block.arguments ?? {}), 130);
        line = `Tool ${block.name}: ${args}`;
      }
      if (!line) continue;
      const key = line.toLowerCase();
      if (seen.has(key)) continue;
      seen.add(key);
      const item = { index, line };
      if (block.type === "toolCall") toolCalls.push(item);
      else assistantText.push(item);
    }
  }

  const selected = [
    ...evenlySpaced(toolCalls, Math.min(3, toolCalls.length)),
    ...evenlySpaced(assistantText, Math.min(3, assistantText.length)),
  ].sort((a, b) => a.index - b.index);

  const counts = {
    messages: elidedEntries.filter((entry) => entry.type === "message").length,
    assistant: elidedEntries.filter(
      (entry) => entry.type === "message" && entry.message?.role === "assistant",
    ).length,
    tools: toolCalls.length,
    goalContext: elidedEntries.filter(
      (entry) => entry.type === "custom_message" && entry.customType === "goal_context",
    ).length,
  };
  const fallback = [
    `Elided entries included ${counts.messages} message records.`,
    `Elided entries included ${counts.assistant} assistant records.`,
    `Assistant records contained ${counts.tools} tool calls.`,
    `The span contained ${counts.goalContext} goal_context continuation prompts.`,
    `The latest prior compaction summary remains the authoritative work checkpoint.`,
    `No session entry was deleted or rewritten by this rescue.`,
  ];

  for (const line of fallback) {
    if (selected.length >= 6) break;
    selected.push({ index: Number.MAX_SAFE_INTEGER, line });
  }
  return selected.slice(0, 6).map((item) => `- ${item.line}`);
}

function buildAddendum(timestamp, elidedEntries) {
  const date = timestamp.slice(0, 10);
  const paragraph =
    `Manual rescue ${date}: This session was manually rescued from a compaction freeze. ` +
    "The elided span was dominated by repeated goal_context continuation prompts carrying no new work product.";
  const addendum = `${paragraph}\n\nFactual digest (mechanically extracted):\n${buildDigest(elidedEntries).join("\n")}`;
  if (Buffer.byteLength(addendum, "utf8") >= 2_048) {
    throw new Error("Mechanical rescue addendum exceeded 2KB");
  }
  return addendum;
}

function createId(byId) {
  for (let attempt = 0; attempt < 100; attempt++) {
    const id = randomUUID().slice(0, 8);
    if (!byId.has(id)) return id;
  }
  throw new Error("Could not generate a unique 8-hex entry id");
}

function retainedContentTokens(branch, keepIndex, pi) {
  let tokens = 0;
  for (let i = keepIndex; i < branch.length; i++) {
    const message = entryMessage(branch[i], pi);
    if (message) tokens += pi.estimateTokens(message);
  }
  return tokens;
}

function buildCandidate(session, latestCompaction, oldKeepIndex, keepIndex, tokensBefore, timestamp, id, pi) {
  const addendum = buildAddendum(timestamp, session.branch.slice(oldKeepIndex, keepIndex));
  const summary = `${latestCompaction.summary.trimEnd()}\n\n${addendum}`;
  const entry = {
    type: "compaction",
    id,
    parentId: session.leaf.id,
    timestamp,
    summary,
    firstKeptEntryId: session.branch[keepIndex].id,
    tokensBefore,
    details: { readFiles: [], modifiedFiles: [] },
    fromHook: true,
  };
  const simulatedEntries = [...session.entries, entry];
  const simulatedById = new Map(session.byId);
  simulatedById.set(entry.id, entry);
  const context = pi.buildSessionContext(simulatedEntries, entry.id, simulatedById);
  const after = pi.estimateContextTokens(context.messages);
  return { entry, addendum, after };
}

async function appendDurably(sessionPath, entry) {
  const handle = await open(sessionPath, "r");
  const { size } = await handle.stat();
  const lastByte = Buffer.alloc(1);
  if (size > 0) await handle.read(lastByte, 0, 1, size - 1);
  await handle.close();

  const prefix = size > 0 && lastByte[0] !== 0x0a ? "\n" : "";
  await appendFile(sessionPath, `${prefix}${JSON.stringify(entry)}\n`, { encoding: "utf8" });
  const written = await open(sessionPath, "r+");
  try {
    await written.sync();
  } finally {
    await written.close();
  }
}

function backupPathFor(sessionPath, timestamp) {
  const stamp = timestamp.replace(/[-:.]/g, "");
  return `${sessionPath}.${stamp}.bak`;
}

function printPlan(plan, sessionPath, keepTokens, dryRun, pi) {
  const afterShouldCompact = pi.shouldCompact(
    plan.candidate.after.tokens,
    RESCUE_CONTEXT_WINDOW,
    plan.settings,
  );
  console.log(`Session: ${sessionPath}`);
  console.log(`Lines parsed: ${plan.session.lineCount}`);
  console.log(
    `Current leaf: ${plan.session.leaf.id} (line ${plan.session.lineById.get(plan.session.leaf.id)})`,
  );
  console.log(
    `Latest compaction: ${plan.latestCompaction.id} (line ${plan.session.lineById.get(plan.latestCompaction.id)})`,
  );
  console.log(`Requested keep tokens: ${keepTokens}`);
  console.log(
    `Initial keep-point: ${plan.session.branch[plan.initial.keepIndex].id} ` +
      `(line ${plan.session.lineById.get(plan.session.branch[plan.initial.keepIndex].id)})`,
  );
  console.log(
    `Chosen keep-point: ${plan.candidate.entry.firstKeptEntryId} ` +
      `(line ${plan.session.lineById.get(plan.candidate.entry.firstKeptEntryId)})`,
  );
  console.log(`Safety-adjusted keep-point: ${plan.keepIndex !== plan.initial.keepIndex ? "yes" : "no"}`);
  console.log(`Retained content estimate: ${plan.retainedTokens} tokens`);
  console.log(`Before context estimate: ${plan.before.tokens} tokens`);
  console.log(`After context estimate: ${plan.candidate.after.tokens} tokens`);
  console.log(`shouldCompact at ${RESCUE_CONTEXT_WINDOW}: ${afterShouldCompact}`);
  console.log(
    `Goal state ancestor: ${plan.goalState.id} ` +
      `(line ${plan.session.lineById.get(plan.goalState.id)}, status ${plan.goalState.data?.status ?? "unknown"})`,
  );
  console.log("\nSummary addendum:\n");
  console.log(plan.candidate.addendum);
  if (dryRun) console.log("\nDry run: no backup created and no entry appended.");
}

async function createPlan(sessionPath, keepTokens, pi) {
  const session = await streamSession(sessionPath);
  const latestCompaction = [...session.branch]
    .reverse()
    .find((entry) => entry.type === "compaction");
  if (!latestCompaction || typeof latestCompaction.summary !== "string") {
    throw new Error("Current branch has no existing compaction summary to carry forward");
  }
  const oldKeepIndex = session.branch.findIndex(
    (entry) => entry.id === latestCompaction.firstKeptEntryId,
  );
  if (oldKeepIndex < 0) {
    throw new Error(
      `Latest compaction firstKeptEntryId ${latestCompaction.firstKeptEntryId} is not on the current branch`,
    );
  }
  const goalState = [...session.branch]
    .reverse()
    .find((entry) => entry.type === "custom" && entry.customType === "thread_goal_state");
  if (!goalState) {
    throw new Error("Current branch has no persisted thread_goal_state entry");
  }

  const currentContext = pi.buildSessionContext(session.entries, session.leaf.id, session.byId);
  const before = pi.estimateContextTokens(currentContext.messages);
  const initial = chooseInitialKeepPoint(session.branch, keepTokens, pi);
  const settings = { ...pi.compactionSettings, keepRecentTokens: keepTokens };
  const timestamp = new Date().toISOString();
  const id = createId(session.byId);
  let candidate;
  let keepIndex;

  for (const boundary of validTurnBoundaries(session.branch, initial.keepIndex, pi)) {
    const proposed = buildCandidate(
      session,
      latestCompaction,
      oldKeepIndex,
      boundary,
      before.tokens,
      timestamp,
      id,
      pi,
    );
    const compactAgain = pi.shouldCompact(proposed.after.tokens, RESCUE_CONTEXT_WINDOW, settings);
    if (proposed.after.tokens < RESCUE_MAX_CONTEXT_TOKENS && !compactAgain) {
      candidate = proposed;
      keepIndex = boundary;
      break;
    }
  }
  if (!candidate || keepIndex === undefined) {
    throw new Error(
      `No valid keep-point produced a context below ${RESCUE_MAX_CONTEXT_TOKENS} tokens`,
    );
  }

  return {
    session,
    latestCompaction,
    goalState,
    before,
    initial,
    settings,
    candidate,
    keepIndex,
    retainedTokens: retainedContentTokens(session.branch, keepIndex, pi),
  };
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  const pi = await loadPiHelpers();
  const stats = statSync(options.sessionPath);
  if (!stats.isFile()) throw new Error(`Not a regular file: ${options.sessionPath}`);

  assertNoLiveLease(options.sessionPath, pi);
  const plan = await createPlan(options.sessionPath, options.keepTokens, pi);
  printPlan(plan, options.sessionPath, options.keepTokens, options.dryRun, pi);
  if (options.dryRun) return;

  assertNoLiveLease(options.sessionPath, pi);
  const backupPath = backupPathFor(options.sessionPath, plan.candidate.entry.timestamp);
  await copyFile(options.sessionPath, backupPath, fsConstants.COPYFILE_EXCL);
  assertNoLiveLease(options.sessionPath, pi);
  await appendDurably(options.sessionPath, plan.candidate.entry);
  console.log(`\nBackup: ${backupPath}`);
  console.log(`Appended compaction entry: ${plan.candidate.entry.id}`);
}

main().catch((error) => {
  console.error(`aoc-prime-goal-rescue: ${error.message}`);
  process.exitCode = 1;
});
