#!/usr/bin/env bash
set -euo pipefail

DEFAULT_TIMEOUT_MINS=30

have() { command -v "$1" >/dev/null 2>&1; }

die() {
  printf 'aoc-prime-review: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: aoc-prime-review --repo <dir> --rubric <file> --out <file>
                        [--tag <tag>] [--timeout-mins <n>]

Runs prime-agent headlessly as a read-only outside examiner of a target repo.
The rubric file's content is the whole prompt — this tool never composes its
own prompt text, so successive runs stay comparable. The response is written
to --out by this wrapper; the agent itself cannot write.

Read-only enforcement (macOS): prime-agent runs under a sandbox-exec profile
that denies every write inside the target repo. A private daemon socket forces
a fresh daemon and IPython kernel to spawn inside the sandbox, so the kernel
inherits the deny rule. The wrapper also snapshots `git status` before and
after the run and refuses to write the report if the repo changed.

  --repo <dir>        repo to review (cwd for the agent)
  --rubric <file>     fixed rubric; its content is the prompt, verbatim
  --out <file>        report destination, written on success
  --tag <tag>         label recorded in the report header (default: review)
  --timeout-mins <n>  hard timeout; a hung run is killed (default: 30)
  -h, --help          show this help
EOF
}

repo=""
rubric=""
out=""
tag="review"
timeout_mins=$DEFAULT_TIMEOUT_MINS

while (($# > 0)); do
  case "$1" in
    --repo|--rubric|--out|--tag|--timeout-mins)
      [[ $# -ge 2 ]] || die "$1 needs a value"
      case "$1" in
        --repo) repo="$2" ;;
        --rubric) rubric="$2" ;;
        --out) out="$2" ;;
        --tag) tag="$2" ;;
        --timeout-mins) timeout_mins="$2" ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

[[ -n "$repo" && -n "$rubric" && -n "$out" ]] || { usage >&2; exit 2; }
[[ -d "$repo" ]] || die "not a directory: $repo"
[[ -f "$rubric" ]] || die "rubric not found: $rubric"
[[ -s "$rubric" ]] || die "rubric is empty: $rubric"
[[ "$timeout_mins" =~ ^[1-9][0-9]*$ ]] || die "--timeout-mins must be a positive integer"

repo="$(cd "$repo" && pwd -P)"
case "$repo" in
  *\"*|*\\*) die "repo path must not contain quotes or backslashes: $repo" ;;
esac

rubric_real="$(cd "$(dirname "$rubric")" && pwd -P)/$(basename "$rubric")"
rubric_label="$rubric_real"
[[ "$rubric_real" == "$repo"/* ]] && rubric_label="${rubric_real#"$repo"/}"

have prime-agent || die "prime-agent not found on PATH; run aoc-prime-agent-install"
if [[ "$(uname -s)" != "Darwin" ]] || ! have sandbox-exec; then
  die "read-only enforcement needs macOS sandbox-exec; not supported on this platform yet"
fi

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/aoc-prime-review.XXXXXX")"
sock="$work_dir/daemon.sock"
response="$work_dir/response.md"
err_log="$work_dir/stderr.log"

# The private daemon outlives the CLI. `prime-agent shutdown` is machine-wide
# (it would kill other sessions' daemons), so find this run's daemon through
# its socket and kill just that.
cleanup() {
  lsof -t -- "$sock" 2>/dev/null | xargs kill 2>/dev/null || true
  rm -rf "$work_dir"
}
trap cleanup EXIT

is_git=0
git_before=""
if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  is_git=1
  git_before="$(git -C "$repo" status --porcelain)"
fi

profile="(version 1)(allow default)(deny file-write* (subpath \"$repo\"))"

# -t ipython pins the tool set to the one builtin; -nc/-ns/-ne/-np keep
# repo-local context files, skills, extensions, and templates out of the
# prompt so every run uses the same examiner.
sandbox-exec -p "$profile" prime-agent \
  -p --mode text \
  --cwd "$repo" \
  --no-session \
  --thinking high \
  -t ipython \
  -nc -ns -ne -np \
  --daemon-socket "$sock" \
  -- "$(cat "$rubric")" >"$response" 2>"$err_log" &
agent_pid=$!

(
  sleep $((timeout_mins * 60))
  kill -TERM "$agent_pid" 2>/dev/null
) 2>/dev/null &
watchdog_pid=$!

agent_status=0
wait "$agent_pid" || agent_status=$?
pkill -P "$watchdog_pid" 2>/dev/null || true
kill "$watchdog_pid" 2>/dev/null || true

if ((agent_status != 0)); then
  tail -n 20 "$err_log" >&2 || true
  if ((agent_status == 143)); then
    die "prime-agent run timed out after $timeout_mins minutes"
  fi
  die "prime-agent exited with status $agent_status"
fi

if [[ ! -s "$response" ]]; then
  tail -n 20 "$err_log" >&2 || true
  die "prime-agent produced no output"
fi

if ((is_git)); then
  git_after="$(git -C "$repo" status --porcelain)"
  if [[ "$git_before" != "$git_after" ]]; then
    {
      printf 'aoc-prime-review: target repo changed during the review; report not written.\n'
      printf 'git status before:\n%s\n' "$git_before"
      printf 'git status after:\n%s\n' "$git_after"
    } >&2
    exit 1
  fi
fi

# prime-agent prints its version to stderr.
agent_version="$(prime-agent --version 2>&1 | head -n 1)"
[[ -n "$agent_version" ]] || agent_version="unknown"

mkdir -p "$(dirname "$out")"
{
  printf '<!-- aoc-prime-review %s tag=%s prime-agent=%s thinking=high rubric=%s -->\n\n' \
    "$(date +%F)" "$tag" "$agent_version" "$rubric_label"
  cat "$response"
} >"$out"

printf 'aoc-prime-review: wrote %s\n' "$out"
