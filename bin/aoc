#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

exec_sibling_or_path() {
  local name="$1"
  shift
  if [[ -x "$DIR/$name" ]]; then
    exec "$DIR/$name" "$@"
  fi
  exec "$name" "$@"
}

# Forward known subcommands to the Rust CLI
if [[ "${1:-}" == "omp" ]]; then
  shift
  exec_sibling_or_path aoc-omp "$@"
fi

if [[ "${1:-}" == "state" ]]; then
  shift
  exec_sibling_or_path aoc-state "$@"
fi

if [[ "${1:-}" == "services" ]]; then
  shift
  case "${1:-workspace}" in
    workspace|focus)
      shift || true
      exec_sibling_or_path aoc-herdr-services focus "$@"
      ;;
    ensure)
      shift
      exec_sibling_or_path aoc-herdr-services ensure "$@"
      ;;
    status|up|start|stop|doctor)
      exec_sibling_or_path aoc-services "$@"
      ;;
    -h|--help)
      echo "Usage: aoc services [workspace|status|up|start|stop|doctor]"
      exit 0
      ;;
    *)
      echo "Unknown services command: $1" >&2
      echo "Usage: aoc services [workspace|status|up|start|stop|doctor]" >&2
      exit 2
      ;;
  esac
fi

if [[ $# -gt 0 ]]; then
  case "$1" in
    task|mem|rlm|insight|overseer|map|dox|see|--help|-h)
      # Assuming aoc-cli is in path or same directory
      if [[ -x "$DIR/aoc-cli" ]]; then
        exec "$DIR/aoc-cli" "$@"
      elif [[ -x "$DIR/../crates/target/debug/aoc-cli" ]]; then
        exec "$DIR/../crates/target/debug/aoc-cli" "$@"
      elif [[ -x "$DIR/../crates/target/release/aoc-cli" ]]; then
        exec "$DIR/../crates/target/release/aoc-cli" "$@"
      elif command -v aoc-cli >/dev/null 2>&1; then
        exec aoc-cli "$@"
      fi
      ;;
  esac
fi

exec_sibling_or_path aoc-herdr-launch "$@"
