#!/usr/bin/env bash
set -euo pipefail

repo_root="${AOC_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
contract_src="$repo_root/config/communication-contract/CONTRACT.md"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/aoc"
canonical_dst="$config_dir/communication-contract.md"

usage() {
  cat <<'USAGE'
Usage: aoc-contract-install [--status]

Install the AOC communication contract for harness launchers.

Options:
  --status    Print the management status of each target
  -h, --help  Show this help text
USAGE
}

log() {
  printf 'aoc-contract-install: %s\n' "$*"
}

status() {
  if [[ -f "$canonical_dst" ]]; then
    printf 'canonical installed\n'
  else
    printf 'canonical missing\n'
  fi
}

install_managed() {
  local src="$1"
  local dst="$2"

  mkdir -p "$(dirname "$dst")"
  if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
    log "kept existing $dst"
    return
  fi
  if [[ -f "$dst" ]]; then
    local backup
    backup="$dst.bak.$(date +%Y%m%d%H%M%S)"
    cp "$dst" "$backup"
    log "backed up $dst -> $backup"
  fi
  install -m 0644 "$src" "$dst"
  log "installed $dst"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --status)
    status
    exit 0
    ;;
  '')
    ;;
  *)
    printf 'aoc-contract-install: unknown option: %s\n' "$1" >&2
    exit 1
    ;;
esac

if [[ ! -f "$contract_src" ]]; then
  printf 'aoc-contract-install: missing %s\n' "$contract_src" >&2
  exit 1
fi

install_managed "$contract_src" "$canonical_dst"
log 'done'
