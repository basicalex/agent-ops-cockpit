#!/usr/bin/env bash
set -euo pipefail

agent_id="pi"
agent_bin="${AOC_PI_BIN:-pi-raw}"
agent_label="PI Agent (npm)"

if [[ "${AOC_AGENT_RUN:-0}" == "1" ]]; then
  if [[ -z "${AOC_HANDSHAKE_MODE:-}" ]]; then
    export AOC_HANDSHAKE_MODE="compact"
  fi
  exec aoc-agent-wrap "$agent_id" "$agent_bin" "$agent_label" "$@"
fi

echo "ERROR: Legacy tab launch was removed; herdr owns workspaces." >&2
exit 1
