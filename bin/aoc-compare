#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
repo_root="$(cd "$script_dir/.." >/dev/null 2>&1 && pwd)"

have() { command -v "$1" >/dev/null 2>&1; }

die() {
  printf 'aoc-compare: %s\n' "$1" >&2
  exit 1
}

warn() {
  printf 'aoc-compare: warning: %s\n' "$1" >&2
}

usage() {
  cat <<'EOF'
Usage: aoc-compare [OPTIONS] SPEC [SPEC...]

Open a Herdr workspace with one side-by-side pane per coding-agent harness.

  SPEC = harness[:model][+contract]
    harness: omp | jcode | prime | claude | claude-codex
    :model  optional model override passed to the harness
    +contract  inject the communication contract into this pane's harness

Options:
  --prompt TEXT        prompt fired into every pane (required unless --prompt-file)
  --prompt-file PATH   read the prompt from a file
  --label NAME         workspace label suffix (default: "compare")
                       full label: "aoc-compare-NAME"
  --contract PATH      contract file override
  --cwd DIR            working directory for all panes (default: current directory)
  -h, --help           show this help

jcode has no system-prompt flag. For +contract, aoc-compare prepends the
contract text to the message sent with `jcode run`.
EOF
}

shell_quote() {
  printf '%q' "$1"
}

prompt=""
prompt_file=""
label_suffix="compare"
contract_override=""
cwd="$(pwd -P)"
declare -a raw_specs=()

while (($# > 0)); do
  case "$1" in
    --prompt|--prompt-file|--label|--contract|--cwd)
      [[ $# -ge 2 ]] || die "$1 needs a value"
      case "$1" in
        --prompt) prompt="$2" ;;
        --prompt-file) prompt_file="$2" ;;
        --label) label_suffix="$2" ;;
        --contract) contract_override="$2" ;;
        --cwd) cwd="$2" ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      usage >&2
      exit 2
      ;;
    *)
      raw_specs+=("$1")
      shift
      ;;
  esac
done

((${#raw_specs[@]} > 0)) || { usage >&2; exit 2; }
[[ -z "$prompt" || -z "$prompt_file" ]] || die "use --prompt or --prompt-file, not both"
if [[ -n "$prompt_file" ]]; then
  [[ -f "$prompt_file" ]] || die "prompt file not found: $prompt_file"
  prompt="$(<"$prompt_file")"
fi
[[ -n "$prompt" ]] || { usage >&2; exit 2; }
[[ -d "$cwd" ]] || die "not a directory: $cwd"
cwd="$(cd "$cwd" && pwd -P)"
[[ -n "$label_suffix" ]] || die "--label must not be empty"

have herdr || die "herdr not found on PATH; install Herdr and start it with aoc"
have jq || die "jq not found on PATH; install jq"

need_contract=0
declare -a spec_harness=()
declare -a spec_model=()
declare -a spec_contract=()
for raw_spec in "${raw_specs[@]}"; do
  spec="$raw_spec"
  wants_contract=0
  if [[ "$spec" == *+contract ]]; then
    wants_contract=1
    spec="${spec%+contract}"
  fi
  [[ "$spec" != *+* ]] || die "invalid spec: $raw_spec"

  harness="$spec"
  model=""
  if [[ "$spec" == *:* ]]; then
    harness="${spec%%:*}"
    model="${spec#*:}"
    [[ "$model" != *:* && -n "$model" ]] || die "invalid spec: $raw_spec"
  fi
  case "$harness" in
    omp|jcode|prime|claude|claude-codex) ;;
    *) die "unknown harness in spec: $raw_spec" ;;
  esac
  [[ -n "$harness" ]] || die "invalid spec: $raw_spec"

  spec_harness+=("$harness")
  spec_model+=("$model")
  spec_contract+=("$wants_contract")
  ((wants_contract)) && need_contract=1
done

contract_path=""
contract_text=""
if ((need_contract)); then
  for candidate in "$contract_override" "${AOC_COMPARE_CONTRACT:-}" "${XDG_CONFIG_HOME:-$HOME/.config}/aoc/communication-contract.md" "$repo_root/config/communication-contract/CONTRACT.md"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      contract_path="$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")"
      break
    fi
  done
  [[ -n "$contract_path" ]] || die "a +contract spec requires a readable communication contract"
  contract_text="$(<"$contract_path")"
fi

raw_omp="${AOC_RAW_OMP_BIN:-}"
if [[ -z "$raw_omp" ]]; then
  if have omp-raw; then
    raw_omp="omp-raw"
  else
    raw_omp="omp"
  fi
fi

prime_wants_model=0
for index in "${!spec_harness[@]}"; do
  if [[ "${spec_harness[$index]}" == "prime" && -n "${spec_model[$index]}" ]]; then
    prime_wants_model=1
  fi
done

prime_model_flag=""
if ((prime_wants_model)) && have prime-agent; then
  prime_help="$(prime-agent --help 2>&1 || true)"
  if [[ "$prime_help" == *"--model <"* || "$prime_help" == *"--model "* ]]; then
    prime_model_flag="--model"
  else
    die "prime-agent does not advertise a --model flag; cannot pass model overrides safely"
  fi
fi

declare -a launch_specs=()
declare -a launch_contracts=()
declare -a launch_commands=()
for index in "${!spec_harness[@]}"; do
  harness="${spec_harness[$index]}"
  model="${spec_model[$index]}"
  wants_contract="${spec_contract[$index]}"
  raw_spec="${raw_specs[$index]}"
  command_string=""

  case "$harness" in
    claude)
      if ! have claude; then
        warn "claude not found on PATH; skipping $raw_spec"
        continue
      fi
      command_string="$(shell_quote claude) --dangerously-skip-permissions"
      [[ -z "$model" ]] || command_string+=" --model $(shell_quote "$model")"
      ((wants_contract)) && command_string+=" --append-system-prompt $(shell_quote "$contract_text")"
      command_string+=" $(shell_quote "$prompt")"
      ;;
    omp)
      if ! have "$raw_omp"; then
        warn "raw OMP binary not found: $raw_omp; skipping $raw_spec"
        continue
      fi
      command_string="$(shell_quote "$raw_omp")"
      [[ -z "$model" ]] || command_string+=" --model $(shell_quote "$model")"
      ((wants_contract)) && command_string+=" --append-system-prompt $(shell_quote "$contract_path")"
      command_string+=" $(shell_quote "$prompt")"
      ;;
    prime)
      if ! have prime-agent; then
        warn "prime-agent not found on PATH; skipping $raw_spec"
        continue
      fi
      command_string="$(shell_quote prime-agent)"
      [[ -z "$model" ]] || command_string+=" $prime_model_flag $(shell_quote "$model")"
      ((wants_contract)) && command_string+=" --append-system-prompt $(shell_quote "$contract_text")"
      command_string+=" -- $(shell_quote "$prompt")"
      ;;
    jcode)
      if ! have jcode; then
        warn "jcode not found on PATH; skipping $raw_spec"
        continue
      fi
      message="$prompt"
      if ((wants_contract)); then
        message=$'OPERATING CONTRACT (follow strictly):\n'"$contract_text"$'\n\nTASK:\n'"$prompt"
      fi
      command_string="$(shell_quote jcode) run"
      [[ -z "$model" ]] || command_string+=" -m $(shell_quote "$model")"
      command_string+=" $(shell_quote "$message")"
      ;;
    claude-codex)
      if ! have claude-codex; then
        warn "claude-codex not found on PATH; skipping $raw_spec"
        continue
      fi
      command_string="$(shell_quote claude-codex)"
      claude_codex_help="$(claude-codex --help 2>&1 || true)"
      [[ "$claude_codex_help" != *"--dangerously-skip-permissions"* ]] || command_string+=" --dangerously-skip-permissions"
      [[ -z "$model" ]] || command_string+=" --model $(shell_quote "$model")"
      ((wants_contract)) && command_string+=" --append-system-prompt $(shell_quote "$contract_text")"
      command_string+=" $(shell_quote "$prompt")"
      ;;
  esac

  launch_specs+=("$raw_spec")
  launch_contracts+=("$wants_contract")
  launch_commands+=("$command_string")
done

((${#launch_specs[@]} > 0)) || die "no requested harnesses are available"

workspace_label="aoc-compare-$label_suffix"
existing_ids="$(herdr workspace list | jq -r --arg label "$workspace_label" '.result.workspaces[]? | select(.label == $label) | .workspace_id')"
while IFS= read -r workspace_id; do
  [[ -z "$workspace_id" ]] || herdr workspace close "$workspace_id" >/dev/null
done <<<"$existing_ids"

read -r workspace_id pane_id < <(herdr workspace create --cwd "$cwd" --label "$workspace_label" --no-focus | jq -r '.result | "\(.workspace.workspace_id) \(.root_pane.pane_id)"')
[[ -n "$workspace_id" && -n "$pane_id" ]] || die "herdr workspace create returned no workspace or root pane id"

declare -a summary_panes=()
for index in "${!launch_specs[@]}"; do
  if ((index > 0)); then
    pane_id="$(herdr pane split "$pane_id" --direction right --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')"
    [[ -n "$pane_id" ]] || die "herdr pane split returned no pane id"
  fi
  pane_name="${launch_specs[$index]//:/-}"
  pane_name="${pane_name//+/-}"
  herdr pane rename "$pane_id" "$pane_name" >/dev/null
  herdr pane run "$pane_id" "${launch_commands[$index]}" >/dev/null
  if [[ "${launch_contracts[$index]}" == "1" ]]; then
    contract_status="yes"
  else
    contract_status="no"
  fi
  summary_panes+=("$pane_id ${launch_specs[$index]} contract $contract_status")
done

printf 'workspace %s\n' "$workspace_id"
printf 'pane %s\n' "${summary_panes[@]}"
