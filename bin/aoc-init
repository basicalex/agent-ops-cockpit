aoc_agents_managed_start='<!-- aoc:managed:start -->'
aoc_agents_managed_end='<!-- aoc:managed:end -->'

# AOC owns only the block between the managed markers. Everything outside it
# belongs to the project and is never changed.
ensure_agents_contract() {
  local agents_file="$1"
  local block_file known_file result="" tag line

  block_file="$(mktemp)"
  {
    printf '%s\n' "$aoc_agents_managed_start"
    aoc_agents_template_body
    printf '%s\n' "$aoc_agents_managed_end"
  } > "$block_file"

  if [[ ! -f "$agents_file" ]]; then
    log "Creating AGENTS.md..."
    cp "$block_file" "$agents_file"
    rm -f "$block_file"
    return
  fi

  known_file="$(mktemp)"
  { aoc_agents_template_body; aoc_agents_retired_template_lines; } > "$known_file"
  result="$(python3 - "$agents_file" "$block_file" "$known_file" "$aoc_agents_managed_start" "$aoc_agents_managed_end" <<'PY'
import re
import sys
from pathlib import Path

path, block_path, known_path = (Path(arg) for arg in sys.argv[1:4])
start, end = sys.argv[4], sys.argv[5]
text = path.read_text(encoding="utf-8")
block = block_path.read_text(encoding="utf-8").rstrip("\n")
lines = text.splitlines()

if start in lines and end in lines[lines.index(start):]:
    # Refresh the managed block in place; leave the rest of the file alone.
    i = lines.index(start)
    j = lines.index(end, i)
    updated = "\n".join(lines[:i] + block.splitlines() + lines[j + 1:]).rstrip("\n") + "\n"
    if updated == text:
        print("same")
    else:
        path.write_text(updated, encoding="utf-8")
        print("refreshed")
    raise SystemExit(0)

# Migration for a file without markers: a whole-file AOC contract, or a
# project file with (or without) an old "## Agent Ops Cockpit (AOC)" section.
# The managed block goes first; every line no AOC template wrote follows, in
# order. Project lines from the old AOC section stay under "## Project rules".
whole_file = bool(lines) and lines[0] == "# AOC Architecture & Agent Guidelines"
known = {line.rstrip() for line in known_path.read_text(encoding="utf-8").splitlines() if line.strip()}
known.update({start, end})
# Lines the old appended AOC section wrote; some drifted outside the section.
known.update({
    "Use the AOC tools for context in this repo.",
    "- **Context:** `.aoc/context.md` (auto-generated project map)",
    "If AOC files are missing or stale, run `aoc-init` at the repo root.",
})

legacy_heading = "## Agent Ops Cockpit (AOC)"
sec_start = sec_end = len(lines)
if legacy_heading in lines:
    sec_start = lines.index(legacy_heading)
    sec_end = next((k for k in range(sec_start + 1, len(lines)) if lines[k].startswith("## ")), len(lines))

# Generic AOC guidance that the managed block now carries.
generic = re.compile(
    r"^Use the AOC tools for |^If AOC files are missing or stale|DESIGN\.md|\.aoc/context\.md|HyperFrames"
)
retired = re.compile(
    r"aoc-" r"mem|aoc-" r"stm|\.aoc/stm|\.aoc/memory\.md|\bSTM\b|\bRTK\b|\brtk\b|\bMind\b|mind-service"
    r"|\bjj\b|Jujutsu|[Zz]ellij|[Cc]ode[Gg]raph|\bTaskmaster\b|\btm\b|aoc[- ]task|[Ss]ear[Xx][Nn][Gg]"
)

section_kept, section_dropped = [], []
for line in lines[sec_start + 1:sec_end]:
    stripped = line.rstrip()
    if not stripped:
        if section_kept:
            section_kept.append("")
        continue
    if stripped in known or generic.search(stripped) or retired.search(stripped):
        section_dropped.append(stripped)
    else:
        section_kept.append(line)
while section_kept and not section_kept[-1]:
    section_kept.pop()

placeholder = object()
rest = [line for line in lines[:sec_start] if line.rstrip() not in known]
if sec_start < len(lines):
    rest += ["", placeholder, ""]
rest += [line for line in lines[sec_end:] if line.rstrip() not in known]

def tidy(seq):
    out, gap = [], False
    for item in seq:
        if isinstance(item, str) and not item.strip():
            gap = True
            continue
        if gap and out:
            out.append("")
        gap = False
        out.append(item)
    return out

rest = tidy(rest)
body = [item for item in rest if item is not placeholder]
if body and body[0].startswith("#"):
    section = ["## Project rules", *section_kept] if section_kept else []
    kept = tidy(sum(([*section, ""] if item is placeholder else [item] for item in rest), []))
else:
    lead = ["## Project rules", *section_kept, ""] if section_kept else (["## Project rules"] if body else [])
    kept = tidy(lead + body)

out = block
if kept:
    out += "\n\n" + "\n".join(kept)
out = out.rstrip("\n") + "\n"
if out == text:
    print("same")
    raise SystemExit(0)
path.write_text(out, encoding="utf-8")
if sec_start < len(lines):
    print("converted")
    report = section_kept
else:
    print("migrated" if whole_file else "added")
    report = kept if whole_file else []
for line in report:
    if line and line != "## Project rules":
        print("kept\t" + line)
for line in section_dropped:
    print("dropped\t" + line)
PY
)"
  rm -f "$known_file" "$block_file"
  case "$result" in
    same) log "AGENTS.md managed block already up to date." ;;
    refreshed) log "Updated the AOC-managed block in AGENTS.md." ;;
    migrated*) log "Moved the AOC contract in AGENTS.md into a managed block." ;;
    converted*) log "Replaced the old AOC section in AGENTS.md with a managed block." ;;
    added*) log "Added the AOC-managed block to AGENTS.md; project content follows it." ;;
  esac
  while IFS=$'\t' read -r tag line; do
    case "$tag" in
      kept) log "  kept project line: $line" ;;
      dropped) log "  dropped old AOC line: $line" ;;
    esac
  done <<< "$result"
}


ensure_git_tracking_policy() {
  local ignore_file="$project_root/.gitignore"
  local changed=0
  local line=""

  if [[ ! -f "$ignore_file" ]]; then
    log "Creating .gitignore..."
    : > "$ignore_file"
  fi

  # $(...) strips a trailing newline, so a non-empty result means the file
  # does not end with one.
  if [[ -s "$ignore_file" && -n "$(tail -c 1 "$ignore_file" 2>/dev/null || true)" ]]; then
    printf '\n' >> "$ignore_file"
  fi

  local rules=(
    "# AOC tracking policy (managed by aoc-init)"
    "!/.aoc/"
    "!/.aoc/**"
    "!/.omp/"
    "!/.omp/extensions/"
    "!/.omp/extensions/**"
    "!/.omp/agents/"
    "!/.omp/agents/**"
    "!/.omp/skills/"
    "!/.omp/skills/**"
    # Backups aoc-init leaves next to refreshed targets (.omp/, .aoc/presets/,
    # .pi/*/). Listed after the re-includes above so this rule wins.
    ".aoc-backups/"
  )

  for line in "${rules[@]}"; do
    if ! grep -Fqx "$line" "$ignore_file"; then
      printf '%s\n' "$line" >> "$ignore_file"
      changed=1
    fi
  done

  if [[ "$changed" == "1" ]]; then
    log "Updated .gitignore to keep .aoc/ and repo-owned .omp/ sources tracked and AOC backups ignored."
  else
    log ".gitignore already keeps .aoc/ and repo-owned .omp/ sources tracked."
  fi
}

# 1. Setup project-local AOC state
setup_project_state() {
  if [[ ! -d "$aoc_dir" ]]; then
    log "Creating .aoc/ directory..."
    mkdir -p "$aoc_dir"
  fi


  # AGENTS.md (project-level agent contract)
  local agents_file="$project_root/AGENTS.md"
  ensure_agents_contract "$agents_file"

  # DESIGN.md (project-level visual/product design contract)
  local design_file="$project_root/DESIGN.md"
  if [[ ! -f "$design_file" ]]; then
    log "Seeding root design contract (DESIGN.md)..."
    write_root_design_contract "$design_file"
  else
    log "Root design contract exists (DESIGN.md). Preserving."
  fi


  # OMP default prompt contract
  local prompts_dir="$aoc_dir/prompts"
  local omp_low_token_prompt="$prompts_dir/omp-low-token.md"
  if [[ ! -d "$prompts_dir" ]]; then
    log "Creating prompts directory ($prompts_dir)..."
    mkdir -p "$prompts_dir"
  fi
  if [[ ! -f "$omp_low_token_prompt" ]]; then
    log "Seeding OMP low-token prompt ($omp_low_token_prompt)..."
    write_omp_low_token_prompt "$omp_low_token_prompt"
  else
    log "OMP low-token prompt exists ($omp_low_token_prompt). Preserving."
  fi

  # Context Generation (project-specific, concise, full injection safe)
  local context_file="$aoc_dir/context.md"
  local context_tmp
  local context_line_budget
  local context_tree_depth
  local context_tree_line_budget
  local readme_heading_limit
  local project_name
  local tree_output=""
  local tree_lines=0
  local context_lines=0
  local readme_headings=""

  project_name="$(basename "$project_root")"
  context_tmp="$(mktemp)"
  context_line_budget="$(positive_int_or_default "${AOC_CONTEXT_LINE_BUDGET:-320}" 320)"
  context_tree_depth="$(positive_int_or_default "${AOC_CONTEXT_TREE_DEPTH:-2}" 2)"
  context_tree_line_budget="$(positive_int_or_default "${AOC_CONTEXT_TREE_LINE_BUDGET:-40}" 40)"
  readme_heading_limit="$(positive_int_or_default "${AOC_CONTEXT_README_HEADING_LIMIT:-40}" 40)"


  if command -v tree >/dev/null 2>&1; then
    tree_output="$(tree -L "$context_tree_depth" --gitignore -I '.git|.aoc|node_modules|target|dist|archive|deprecated|.venv|venv|__pycache__' "$project_root" 2>/dev/null || true)"
  else
    tree_output="$(cd "$project_root" && find . -maxdepth "$context_tree_depth" \( -path './.git' -o -path './.aoc' -o -path './node_modules' -o -path './target' -o -path './dist' -o -path './archive' -o -path './deprecated' -o -path './.venv' -o -path './venv' -o -path './__pycache__' \) -prune -o -print 2>/dev/null | sort || true)"
  fi
  tree_lines="$(printf '%s\n' "$tree_output" | wc -l | tr -d ' ')"

  if [[ -f "$project_root/README.md" ]]; then
    readme_headings="$(grep -E '^#{1,6} ' "$project_root/README.md" | head -n "$readme_heading_limit" || true)"
  fi

  log "Generating/Updating Context ($context_file)..."

  {
    echo "# Project Context Snapshot"
    echo
    echo "## Repository"
    echo "- Name: $project_name"
    echo "- Root: ${project_root/#$HOME/\~}"
    aoc_vcs_context_lines

    echo
    echo "## Key Files"
    local found_key_file=0
    local key_file
    for key_file in \
      "README.md" \
      "DESIGN.md" \
      "Makefile" \
      "justfile" \
      "package.json" \
      "pnpm-lock.yaml" \
      "yarn.lock" \
      "bun.lockb" \
      "Cargo.toml" \
      "go.mod" \
      "pyproject.toml" \
      "requirements.txt" \
      "Dockerfile" \
      "docker-compose.yml" \
      "docker-compose.yaml"; do
      if [[ -f "$project_root/$key_file" ]]; then
        echo "- $key_file"
        found_key_file=1
      fi
    done
    if [[ "$found_key_file" == "0" ]]; then
      echo "- No common manifest files detected."
    fi

    echo
    echo "## Project Structure (tree -L $context_tree_depth)"
    echo '```'
    if [[ -n "$tree_output" ]]; then
      if (( tree_lines > context_tree_line_budget )); then
        head -n "$context_tree_line_budget" <<<"$tree_output"
        echo "... [tree truncated to ${context_tree_line_budget} lines]"
      else
        printf '%s\n' "$tree_output"
      fi
    else
      echo "No project structure entries detected."
    fi
    echo '```'

    if [[ -n "$readme_headings" ]]; then
      echo
      echo "## README Headings"
      printf '%s\n' "$readme_headings"
    fi

    echo
    echo "## Design Contract"
    if [[ -f "$project_root/DESIGN.md" ]]; then
      echo "- Root DESIGN.md: present"
      echo "- Use as visual/product design source before product-facing UI, docs-site, marketing, or media changes."
    else
      echo "- Root DESIGN.md: missing (run aoc-init to seed)"
    fi

  } > "$context_tmp"

  context_lines="$(wc -l < "$context_tmp" | tr -d ' ')"
  if (( context_lines > context_line_budget )); then
    {
      head -n "$context_line_budget" "$context_tmp"
      echo
      echo "... [context capped at ${context_line_budget} lines; adjust AOC_CONTEXT_LINE_BUDGET if needed]"
    } > "$context_file"
    rm -f "$context_tmp"
    log "Context exceeded budget (${context_lines} lines); wrote capped context (${context_line_budget} lines)."
  else
    mv "$context_tmp" "$context_file"
  fi

}

# 1b. Validate OMP skills
setup_skills() {
  local omp_skills_dir="$project_root/.omp/skills"


  if [[ -x "$script_dir/aoc-skill" ]]; then
    log "Validating OMP skill baseline (.omp/skills)..."
    (cd "$project_root" && "$script_dir/aoc-skill" validate --root "$project_root" || true)
  elif command -v aoc-skill >/dev/null 2>&1; then
    log "Validating OMP skill baseline (.omp/skills)..."
    (cd "$project_root" && aoc-skill validate --root "$project_root" || true)
  else
    warn "aoc-skill not found; .omp/skills baseline may be incomplete."
  fi
}


cleanup_retired_creative_project_assets() {
  local rel target marker
  local -a retired_creative=(
    .aoc/presets/hyperframes
    .aoc/presets/design
    .omp/skills/aoc-hyperframes .omp/skills/hyperframes .omp/skills/hyperframes-cli
    .omp/skills/website-to-hyperframes .omp/skills/gsap
    .omp/skills/animejs-core-api .omp/skills/animejs-performance-a11y
    .omp/skills/animejs-react-integration .omp/skills/animejs-reviewer
    .omp/skills/animejs-scene-planner .omp/skills/animejs-scroll-interaction
    .omp/skills/animejs-svg-motion .omp/skills/animejs-text-splitting
    .omp/skills/animejs-timelines
    .omp/skills/design-diff .omp/skills/design-director .omp/skills/design-handoff
    .omp/skills/design-premium-ui .omp/skills/design-redesign .omp/skills/design-review
    .omp/skills/design-spec .omp/skills/design-tokens .omp/skills/motion-director
    .omp/skills/ponytail .omp/skills/ponytail-audit .omp/skills/ponytail-debt
    .omp/skills/ponytail-help .omp/skills/ponytail-review
    .omp/skills/architecture-design .omp/skills/enforce-dashboard-ux-guardrails
    .omp/skills/frontend-design .omp/skills/funnel-design
    .omp/skills/omarchy-theme-ops .omp/skills/safe-gamification
    .omp/skills/aoc-stm .omp/skills/aoc-lexicon .omp/skills/browser-qa
    .omp/skills/spec-rpg-authoring .omp/skills/tm-cc
    .omp/agents/brand-concept.md .omp/agents/brand-strategy.md
    .omp/agents/hyperframes-content.md .omp/agents/svg-asset.md
    .omp/extensions/aoc-brand-content.ts
    .pi/skills/aoc-hyperframes .pi/skills/hyperframes .pi/skills/hyperframes-cli
    .pi/skills/website-to-hyperframes .pi/skills/gsap
    .pi/prompts/hyperframes.md
    .aoc/open-design .aoc/skills-optional .aoc/prompts-optional
  )
  local -a removed=()

  for rel in "${retired_creative[@]}"; do
    target="$project_root/$rel"
    if [[ "$rel" != .aoc/open-design && "$rel" != .aoc/skills-optional && "$rel" != .aoc/prompts-optional ]] &&
      [[ -e "$target" || -L "$target" ]] && ! is_aoc_managed_target "$target" &&
      ! python3 - "$aoc_managed_assets_file" "$rel" <<'PY'
import json
import sys
from pathlib import Path

try:
    assets = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("assets", {})
except (OSError, ValueError, AttributeError):
    raise SystemExit(1)
raise SystemExit(0 if isinstance(assets, dict) and sys.argv[2] in assets else 1)
PY
    then
      warn "Preserving unmarked retired creative asset: $rel"
      continue
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      rm -rf -- "$target"
      log "Removed retired creative asset: $rel"
    fi
    marker="$target.aoc-managed"
    rm -f -- "$marker"
    removed+=("$rel")
  done

  if [[ -f "$aoc_managed_assets_file" ]]; then
    python3 - "$aoc_managed_assets_file" ${removed[@]+"${removed[@]}"} <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, ValueError):
    raise SystemExit(0)
assets = data.get("assets")
if not isinstance(assets, dict):
    raise SystemExit(0)
for rel in sys.argv[2:]:
    for entry in list(assets):
        if entry == rel or entry.startswith(rel + "/"):
            del assets[entry]
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
  fi
}

setup_project_omp_assets() {
  local omp_seed_root
  omp_seed_root="$(aoc_omp_seed_root)"
  local project_omp_root="$project_root/.omp"
  local kind=""
  local source_dir=""
  local target_dir=""

  if [[ ! -d "$omp_seed_root" ]]; then
    warn "Missing AOC OMP asset seed directory: $omp_seed_root"
    return 0
  fi

  local filtered_seed=""
  local name=""
  mkdir -p "$project_omp_root"
  for kind in extensions agents skills; do
    source_dir="$omp_seed_root/$kind"
    target_dir="$project_omp_root/$kind"
    [[ -d "$source_dir" ]] || continue
    if [[ "$(cd "$source_dir" && pwd -P)" == "$(mkdir -p "$target_dir" && cd "$target_dir" && pwd -P)" ]]; then
      log "Project OMP $kind already canonical ($target_dir)."
      continue
    fi
    if [[ "$kind" == "extensions" ]]; then
      for name in "${aoc_retired_omp_extensions[@]}"; do
        [[ -e "$source_dir/$name" ]] || continue
        if [[ -z "$filtered_seed" ]]; then
          filtered_seed="$(mktemp -d)"
          copy_tree_force "$source_dir" "$filtered_seed/extensions"
        fi
        rm -f -- "$filtered_seed/extensions/$name"
        warn "Skipped retired OMP extension in stale seed: $source_dir/$name"
      done
      [[ -z "$filtered_seed" ]] || source_dir="$filtered_seed/extensions"
    fi
    copy_tree_force_managed "$source_dir" "$target_dir" "omp-$kind"
    if [[ "$source_dir" != "$omp_seed_root/$kind" ]]; then
      # Name the real seed in the marker, not the filtered temp copy.
      write_aoc_managed_marker "$target_dir" "omp-$kind" "$omp_seed_root/$kind"
    fi
    log "Seeded project OMP $kind: .omp/$kind"
  done
  [[ -z "$filtered_seed" ]] || rm -rf -- "$filtered_seed"

  local manifest_source="$omp_seed_root/manifest.toml"
  local manifest_target="$project_omp_root/manifest.toml"
  if [[ -f "$manifest_source" ]]; then
    copy_file_force_managed "$manifest_source" "$manifest_target" "omp-manifest"
    log "Seeded project OMP manifest: .omp/manifest.toml"
  fi
}

sync_omp_extension_config() {
  local omp_extension_dir="${AOC_OMP_AGENT_DIR:-$HOME/.omp/agent}/extensions"
  local omp_config="${AOC_OMP_AGENT_CONFIG:-$HOME/.omp/agent/config.yml}"
  local required_extensions=()
  load_omp_active_array required_extensions extensions
  python3 - "$omp_config" "$omp_extension_dir" "${required_extensions[@]}" <<'PY'
import sys
from pathlib import Path

config = Path(sys.argv[1])
extension_dir = Path(sys.argv[2])
extensions = [str(extension_dir / name) for name in sys.argv[3:]]
if not config.exists():
    sys.exit(0)

lines = config.read_text().splitlines()
block = ["extensions: "] + [f"  - {value}" for value in extensions]
start = None
for index, line in enumerate(lines):
    if line.startswith("extensions:"):
        start = index
        break
if start is None:
    lines.extend(block)
else:
    end = start + 1
    while end < len(lines) and (lines[end].startswith(" ") or lines[end].strip() == ""):
        end += 1
    lines[start:end] = block
config.write_text("\n".join(lines) + "\n")
PY
}

sync_omp_agent_disable_config() {
  local omp_config="${AOC_OMP_AGENT_CONFIG:-$HOME/.omp/agent/config.yml}"
  local active_agents=()
  local manifest_agents=()
  load_omp_active_array active_agents agents
  load_omp_manifest_array manifest_agents agents
  python3 - "$omp_config" "${active_agents[@]}" -- "${manifest_agents[@]}" <<'PY'
import sys
from pathlib import Path

config = Path(sys.argv[1])
if "--" not in sys.argv[2:]:
    raise SystemExit("missing separator")
sep = sys.argv.index("--")
active = {Path(name).stem for name in sys.argv[2:sep]}
disabled = [Path(name).stem for name in sys.argv[sep + 1:] if Path(name).stem not in active]
if not config.exists():
    raise SystemExit(0)

lines = config.read_text().splitlines()
task_start = None
for index, line in enumerate(lines):
    if line.startswith("task:"):
        task_start = index
        break
if task_start is None:
    lines.extend(["task:"])
    task_start = len(lines) - 1

task_end = task_start + 1
while task_end < len(lines) and (lines[task_end].startswith(" ") or lines[task_end].strip() == ""):
    task_end += 1

disabled_start = None
for index in range(task_start + 1, task_end):
    if lines[index].startswith("  disabledAgents:"):
        disabled_start = index
        break
if disabled_start is not None:
    disabled_end = disabled_start + 1
    while disabled_end < task_end and (lines[disabled_end].startswith("    ") or lines[disabled_end].strip() == ""):
        disabled_end += 1
    del lines[disabled_start:disabled_end]

block = ["  disabledAgents: []"] if not disabled else ["  disabledAgents:"] + [f"    - {name}" for name in disabled]
lines[task_start + 1:task_start + 1] = block
config.write_text("\n".join(lines) + "\n")
PY
}

sync_omp_extension_disable_config() {
  local omp_config="${AOC_OMP_AGENT_CONFIG:-$HOME/.omp/agent/config.yml}"
  local active_extensions=()
  local manifest_extensions=()
  load_omp_active_array active_extensions extensions
  load_omp_manifest_array manifest_extensions extensions
  python3 - "$omp_config" "${active_extensions[@]}" -- "${manifest_extensions[@]}" <<'PY'
import sys
from pathlib import Path

config = Path(sys.argv[1])
if "--" not in sys.argv[2:]:
    raise SystemExit("missing separator")
sep = sys.argv.index("--")
def ext_id(name: str) -> str:
    return f"extension-module:{Path(name).stem}"
active = {ext_id(name) for name in sys.argv[2:sep]}
manifest = [ext_id(name) for name in sys.argv[sep + 1:]]
manifest_set = set(manifest)
profile_disabled = [name for name in manifest if name not in active]
if not config.exists():
    raise SystemExit(0)

lines = config.read_text().splitlines()
start = None
for index, line in enumerate(lines):
    if line.startswith("disabledExtensions:"):
        start = index
        break
existing = []
if start is not None:
    end = start + 1
    if lines[start].strip() != "disabledExtensions: []":
        while end < len(lines) and (lines[end].startswith(" ") or lines[end].strip() == ""):
            stripped = lines[end].strip()
            if stripped.startswith("- "):
                existing.append(stripped[2:])
            end += 1
    else:
        end = start + 1
    del lines[start:end]

preserved = [name for name in existing if name not in manifest_set]
final = preserved + [name for name in profile_disabled if name not in preserved]
block = ["disabledExtensions: []"] if not final else ["disabledExtensions:"] + [f"  - {name}" for name in final]
insert_at = start if start is not None else 0
lines[insert_at:insert_at] = block
config.write_text("\n".join(lines) + "\n")
PY
}

# Remove assets an earlier aoc-init installed into the user OMP dir that the
# current seed no longer installs. The record holds the names installed last.
prune_unseeded_omp_assets() {
  local target_dir="$1"
  shift
  local record="$target_dir/.aoc-seeded"
  local name=""
  if [[ -f "$record" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" && "$name" != */* && "$name" != .* ]] || continue
      if ! array_contains "$name" "$@"; then
        rm -rf -- "${target_dir:?}/$name"
        log "Removed OMP asset no longer in the AOC seed: $target_dir/$name"
      fi
    done < "$record"
  fi
  if (( $# > 0 )); then printf '%s\n' "$@" > "$record"; else : > "$record"; fi
}

setup_omp_extensions() {
  local omp_extension_seed_dir
  omp_extension_seed_dir="$(aoc_omp_seed_root)/extensions"
  local omp_extension_dir="${AOC_OMP_AGENT_DIR:-$HOME/.omp/agent}/extensions"
  local extension_name=""
  local extension_src=""
  local extension_dst=""
  local required_extensions=()
  load_omp_active_array required_extensions extensions

  if [[ ! -d "$omp_extension_seed_dir" ]]; then
    warn "Missing AOC OMP extension seed directory: $omp_extension_seed_dir"
    return 0
  fi

  mkdir -p "$omp_extension_dir"
  for extension_name in "${required_extensions[@]}"; do
    extension_src="$omp_extension_seed_dir/$extension_name"
    extension_dst="$omp_extension_dir/$extension_name"
    if [[ -f "$extension_src" ]]; then
      cp "$extension_src" "$extension_dst"
      log "Installed AOC OMP extension: $extension_dst"
    else
      warn "Missing AOC OMP extension seed: $extension_name"
    fi
  done

  if [[ "${#required_extensions[@]}" -gt 0 && -f "$omp_extension_seed_dir/aoc-runtime.ts" ]]; then
    cp "$omp_extension_seed_dir/aoc-runtime.ts" "$omp_extension_dir/aoc-runtime.ts"
  fi

  local manifest_extensions=()
  load_omp_manifest_array manifest_extensions extensions
  for extension_name in "${manifest_extensions[@]}"; do
    if ! array_contains "$extension_name" "${required_extensions[@]}"; then
      rm -f "$omp_extension_dir/$extension_name"
    fi
  done

  for extension_name in "${aoc_retired_omp_extensions[@]}"; do
    rm -f "$omp_extension_dir/$extension_name"
  done
  local seeded_extensions=("${required_extensions[@]}")
  if [[ "${#required_extensions[@]}" -gt 0 && -f "$omp_extension_seed_dir/aoc-runtime.ts" ]]; then
    seeded_extensions+=(aoc-runtime.ts)
  fi
  prune_unseeded_omp_assets "$omp_extension_dir" "${seeded_extensions[@]}"
  sync_omp_extension_disable_config
  sync_omp_extension_config
  log "Updated OMP extension config: ${AOC_OMP_AGENT_CONFIG:-$HOME/.omp/agent/config.yml}"

}

setup_omp_style_state() {
  local style_state_file="${AOC_STYLE_STATE_FILE:-$HOME/.omp/agent/style-hooks.json}"
  if [[ -f "$style_state_file" ]]; then
    log "OMP style hook state exists ($style_state_file). Preserving."
    return 0
  fi

  mkdir -p "$(dirname "$style_state_file")"
  cat > "$style_state_file" <<'EOF'
{
  "version": 1,
  "ponytail": "off",
  "caveman": "off",
  "updatedAt": ""
}
EOF
  log "Seeded OMP style hook state: $style_state_file"
}


setup_omp_skills() {
  local omp_skill_seed_dir
  omp_skill_seed_dir="$(aoc_omp_seed_root)/skills"
  local omp_skill_dir="${AOC_OMP_AGENT_DIR:-$HOME/.omp/agent}/skills"
  local skill_name=""
  local skill_src=""
  local skill_dst=""
  local required_skills=()
  load_omp_active_array required_skills skills

  if [[ ! -d "$omp_skill_seed_dir" ]]; then
    warn "Missing AOC OMP skill seed directory: $omp_skill_seed_dir"
    return 0
  fi

  mkdir -p "$omp_skill_dir"
  for skill_name in "${required_skills[@]}"; do
    skill_src="$omp_skill_seed_dir/$skill_name"
    skill_dst="$omp_skill_dir/$skill_name"
    if [[ -d "$skill_src" ]]; then
      rm -rf "$skill_dst"
      cp -R "$skill_src" "$skill_dst"
      log "Installed AOC OMP skill: $skill_dst"
    else
      warn "Missing AOC OMP skill seed: $skill_name"
    fi
  done
  local manifest_skills=()
  load_omp_manifest_array manifest_skills skills
  for skill_name in "${manifest_skills[@]}"; do
    if ! array_contains "$skill_name" "${required_skills[@]}"; then
      rm -rf "$omp_skill_dir/$skill_name"
    fi
  done

  rm -rf "$omp_skill_dir/ponytail" "$omp_skill_dir/ponytail-review" "$omp_skill_dir/ponytail-audit" \
    "$omp_skill_dir/ponytail-debt" "$omp_skill_dir/ponytail-help" \
    "$omp_skill_dir/aoc-hyperframes" "$omp_skill_dir/hyperframes" "$omp_skill_dir/hyperframes-cli" \
    "$omp_skill_dir/website-to-hyperframes" "$omp_skill_dir/gsap" \
    "$omp_skill_dir/animejs-core-api" "$omp_skill_dir/animejs-performance-a11y" \
    "$omp_skill_dir/animejs-react-integration" "$omp_skill_dir/animejs-reviewer" \
    "$omp_skill_dir/animejs-scene-planner" "$omp_skill_dir/animejs-scroll-interaction" \
    "$omp_skill_dir/animejs-svg-motion" "$omp_skill_dir/animejs-text-splitting" \
    "$omp_skill_dir/animejs-timelines" "$omp_skill_dir/design-diff" \
    "$omp_skill_dir/design-director" "$omp_skill_dir/design-handoff" \
    "$omp_skill_dir/design-premium-ui" "$omp_skill_dir/design-redesign" \
    "$omp_skill_dir/design-review" "$omp_skill_dir/design-spec" \
    "$omp_skill_dir/design-tokens" "$omp_skill_dir/motion-director" \
    "$omp_skill_dir/architecture-design" "$omp_skill_dir/enforce-dashboard-ux-guardrails" \
    "$omp_skill_dir/frontend-design" "$omp_skill_dir/funnel-design" \
    "$omp_skill_dir/omarchy-theme-ops" "$omp_skill_dir/safe-gamification" \
    "$omp_skill_dir/aoc-stm" "$omp_skill_dir/aoc-lexicon" "$omp_skill_dir/browser-qa" \
    "$omp_skill_dir/spec-rpg-authoring" "$omp_skill_dir/tm-cc"
  prune_unseeded_omp_assets "$omp_skill_dir" "${required_skills[@]}"
}
setup_omp_agents() {
  local omp_agent_seed_dir
  omp_agent_seed_dir="$(aoc_omp_seed_root)/agents"
  local omp_agent_dir="${AOC_OMP_AGENT_DIR:-$HOME/.omp/agent}/agents"
  local agent_name=""
  local agent_src=""
  local agent_dst=""
  local required_agents=()
  load_omp_active_array required_agents agents

  if [[ ! -d "$omp_agent_seed_dir" ]]; then
    warn "Missing AOC OMP agent seed directory: $omp_agent_seed_dir"
    return 0
  fi

  mkdir -p "$omp_agent_dir"
  for agent_name in "${required_agents[@]}"; do
    agent_src="$omp_agent_seed_dir/$agent_name"
    agent_dst="$omp_agent_dir/$agent_name"
    if [[ -f "$agent_src" ]]; then
      cp "$agent_src" "$agent_dst"
      log "Installed AOC OMP agent template: $agent_dst"
    else
      warn "Missing AOC OMP agent seed: $agent_name"
    fi
  done

  local manifest_agents=()
  load_omp_manifest_array manifest_agents agents
  for agent_name in "${manifest_agents[@]}"; do
    if ! array_contains "$agent_name" "${required_agents[@]}"; then
      rm -f "$omp_agent_dir/$agent_name"
    fi
  done
  rm -f "$omp_agent_dir/brand-concept.md" "$omp_agent_dir/brand-strategy.md" \
    "$omp_agent_dir/svg-asset.md" "$omp_agent_dir/hyperframes-content.md"
  prune_unseeded_omp_assets "$omp_agent_dir" "${required_agents[@]}"
  sync_omp_agent_disable_config
}


setup_aoc_preset_assets() {
  local presets_dir="$project_root/.aoc/presets"
  local global_presets_dir="$aoc_config_dir/presets"
  local canonical_preset_seed_dirs=(
    "$script_dir/../.aoc/presets"
    "$global_presets_dir"
  )
  local candidate=""

  mkdir -p "$presets_dir" "$global_presets_dir"

  seed_aoc_preset_asset() {
    local preset_name="$1"
    local preset_seed_dir=""
    local target_preset_dir="$presets_dir/$preset_name"
    local cache_preset_dir="$global_presets_dir/$preset_name"

    for candidate in "${canonical_preset_seed_dirs[@]}"; do
      if [[ -d "$candidate/$preset_name" ]]; then
        preset_seed_dir="$candidate/$preset_name"
        break
      fi
    done

    if [[ -n "$preset_seed_dir" ]]; then
      if [[ ! -d "$target_preset_dir" ]]; then
        copy_tree_force_managed "$preset_seed_dir" "$target_preset_dir" "preset/$preset_name"
        log "Seeded AOC preset assets: $preset_name"
      else
        copy_tree_force_managed "$preset_seed_dir" "$target_preset_dir" "preset/$preset_name"
        log "Refreshed managed AOC preset assets: $preset_name"
      fi

      if [[ ! -d "$cache_preset_dir" ]] || ! directories_match "$preset_seed_dir" "$cache_preset_dir"; then
        copy_tree_force "$preset_seed_dir" "$cache_preset_dir"
        log "Refreshed global AOC preset template: $preset_name"
      fi
    else
      warn "Missing AOC preset template: $preset_name"
    fi
  }

  # Seed compact production preset assets. Presets are cognitive positioning
  # layers; mode-specific skills remain lazy/filtered.
  seed_aoc_preset_asset "ops"
  seed_aoc_preset_asset "research"
  seed_aoc_preset_asset "test"

}

# 3. Environment Checks
setup_env() {
  if [[ ! -f "$project_root/.env" && -f "$project_root/.env.example" ]]; then
    log "Copying .env.example to .env..."
    cp "$project_root/.env.example" "$project_root/.env"
  fi
}

setup_aoc_map() {
  local map_dir="$project_root/.aoc/map"
  local aoc_map_skill="$project_root/.omp/skills/aoc-map/SKILL.md"
  local aoc_map_skill_dir="$project_root/.omp/skills/aoc-map"
  local canonical_skill_src="$script_dir/../.omp/skills/aoc-map/SKILL.md"
  local output=""
  local -a init_args=(init)

  if (( aoc_init_force == 1 )); then
    init_args+=(--force)
  fi

  if [[ -f "$aoc_map_skill" && $aoc_init_force -eq 0 ]]; then
    log "AOC Map skill exists ($aoc_map_skill). Preserving."
  elif [[ -f "$canonical_skill_src" ]]; then
    mkdir -p "$aoc_map_skill_dir"
    cp "$canonical_skill_src" "$aoc_map_skill"
    if (( aoc_init_force == 1 )); then
      log "Refreshed AOC Map skill ($aoc_map_skill)."
    else
      log "Seeded AOC Map skill ($aoc_map_skill)."
    fi
  fi

  mkdir -p "$map_dir"
  log "AOC Map workspace directory ready ($map_dir)."
}



main() {
  if [[ "$aoc_init_check_managed_only" == "1" ]]; then
    refresh_aoc_managed_manifest
    print_project_aoc_status
    return 0
  fi

  if [[ "$aoc_init_status_only" == "1" ]]; then
    print_project_aoc_status
    return 0
  fi

  "$script_dir/aoc-claude-install" --settings-only
  log "Initializing AOC in: $project_root"
  setup_project_state
  prepare_project_aoc_state
  apply_project_version_migrations
  cleanup_retired_creative_project_assets
  setup_project_omp_assets
  setup_omp_extensions
  setup_omp_style_state
  setup_omp_skills
  setup_omp_agents
  setup_aoc_preset_assets
  setup_skills
  setup_aoc_map
  ensure_git_tracking_policy
  setup_env
  refresh_aoc_managed_manifest
  write_project_aoc_state
  log "AOC Initialization Complete. Ready to launch."
}

main
