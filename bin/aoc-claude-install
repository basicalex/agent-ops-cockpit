#!/usr/bin/env bash
set -euo pipefail

# Installs the Claude-side orchestration assets (global CLAUDE.md policy and
# user-level skills) from the repo's claude/ directory into ~/.claude.
# Follows the aoc-herdr-install convention: copy with timestamped backup.

repo_root="${AOC_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
claude_src="$repo_root/claude"
claude_home="${AOC_CLAUDE_DIR:-$HOME/.claude}"
skills_dst="$claude_home/skills"

if [[ ! -d "$claude_src" ]]; then
  echo "aoc-claude-install: missing $claude_src" >&2
  exit 1
fi

mkdir -p "$claude_home" "$skills_dst"

install_file() {
  local src="$1"
  local dst="$2"
  if [[ -f "$dst" ]] && ! cmp -s "$src" "$dst"; then
    local backup
    backup="$dst.bak.$(date +%Y%m%d%H%M%S)"
    cp "$dst" "$backup"
    echo "aoc-claude-install: backed up $dst -> $backup"
  fi
  cp "$src" "$dst"
  echo "aoc-claude-install: installed $dst"
}

warn_orchestration_prereqs() {
  local status_output=""

  if ! command -v omp >/dev/null 2>&1; then
    echo "Warning: omp is not on PATH; Claude omp workers will not launch until omp is installed" >&2
  fi

  if ! command -v herdr >/dev/null 2>&1; then
    echo "Warning: herdr is not on PATH; run: herdr integration install omp" >&2
    return 0
  fi

  if ! status_output="$(herdr integration status 2>/dev/null)"; then
    echo "Warning: unable to check Herdr integration status; run: herdr integration install omp" >&2
    return 0
  fi

  if [[ "$status_output" != *"omp:"* || "$status_output" == *"omp: not installed"* ]]; then
    echo "Warning: Herdr omp integration is not installed; run: herdr integration install omp" >&2
  fi
}

install_file "$claude_src/CLAUDE.global.md" "$claude_home/CLAUDE.md"

for skill_dir in "$claude_src/skills"/*/; do
  [[ -d "$skill_dir" ]] || continue
  skill_name="$(basename "$skill_dir")"
  mkdir -p "$skills_dst/$skill_name"
  for f in "$skill_dir"*; do
    [[ -f "$f" ]] || continue
    install_file "$f" "$skills_dst/$skill_name/$(basename "$f")"
  done
done

warn_orchestration_prereqs
echo "aoc-claude-install: done"
