// Shared by both listing pages: /_search.json is owner-only and holds the plain
// text of every page, so a search covers page content, not just titles.
const SEARCH_JS = `function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];});}
function snip(t,at){var s=Math.max(0,at-50),c=String(t).substr(s,120).replace(/\\s+/g," ").trim();return (s>0?"…":"")+c+(s+120<String(t).length?"…":"");}
function words(v){return v.trim().toLowerCase().split(/\\s+/).filter(Boolean);}
function rank(k,st){return k==="decision"?(st==="superseded"?1:0):2;}
function index(onready){var st={state:0,data:null};st.load=function(){if(st.state)return;st.state=1;
fetch("/_search.json",{headers:{accept:"application/json"}}).then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){st.data=j;st.state=2;onready();}).catch(function(){st.state=3;onready();});};return st;}`;

function listShell(title: string, body: string, script = ""): string {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title>${LIST_CSS}</head><body><main>${body}</main>${script}</body></html>\n`;
}
function plural(n: number, word: string): string {
  return `${n} ${word}${n === 1 ? "" : "s"}`;
}
function byUpdatedDesc(a: Entry, b: Entry): number {
  return b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title);
}
function latestUpdate(entries: Entry[]): string {
  return entries.reduce((acc, e) => (e.updated > acc ? e.updated : acc), "");
}

function rootPage(host: string, byProject: Map<string, Entry[]>): string {
  const projects = [...byProject.entries()].sort(
    (a, b) => latestUpdate(b[1]).localeCompare(latestUpdate(a[1])) || a[0].localeCompare(b[0]),
  );
  const cards = projects
    .map(([p, entries]) => {
      const decisions = entries.filter(isActiveDecision).sort(byUpdatedDesc);
      const rest = entries.filter((e) => !isActiveDecision(e)).sort(byUpdatedDesc);
      const teaser = [
        ...decisions.slice(0, 3).map((e) => `<b>${esc(e.title)}</b>`),
        ...rest.slice(0, Math.max(0, 3 - decisions.length)).map((e) => esc(e.title)),
      ].join(`<i>·</i>`);
      const nd = decisions.length ? `<span class="nd">${plural(decisions.length, "decision")}</span>` : "";
      return `<a class="proj" href="/${p}/"><span class="name">${esc(p)}</span><span class="side">${nd}<span class="n">${plural(entries.length, "page")}</span><span class="d">${esc(latestUpdate(entries))}</span></span><span class="teaser">${teaser}</span></a>`;
    })
    .join("");
  const total = [...byProject.values()].reduce((n, e) => n + e.length, 0);
  const body = `<div class="top"><span class="crumb">${esc(host)}</span><a class="out" href="/_logout">Sign out</a></div>
<h1>Intrface documents</h1>
<p class="count"><b>${plural(projects.length, "project")}</b> · <b>${plural(total, "page")}</b></p>
<div class="filter"><input id="q" type="search" autocomplete="off" aria-label="Search all pages" placeholder="Search all pages"></div>
<div class="list" id="projects">${cards}</div>
<div class="list" id="results" hidden></div>
<p class="empty" id="empty" hidden>No page matches that text.</p>
<p class="more" id="more" hidden></p>
<p class="empty" id="err" hidden>Search unavailable.</p>`;
  const script = `<script>
(function(){${SEARCH_JS}
var q=document.getElementById("q"),projects=document.getElementById("projects"),results=document.getElementById("results"),empty=document.getElementById("empty"),more=document.getElementById("more"),err=document.getElementById("err");
var idx=index(run);
function row(it,s){return '<div class="row"><a class="t" href="'+esc(it.url)+'">'+esc(it.title)+'</a><span class="d">'+esc(it.updated)+'</span><span class="meta"><span class="slug">'+esc(it.ref)+'</span>'+(it.kind==="decision"?'<span class="badge kind">decision</span>':'')+(it.status==="superseded"?'<span class="badge">superseded</span>':'')+'<span class="badge '+esc(it.visibility)+'">'+esc(it.visibility)+'</span></span>'+(s?'<p class="snip">'+esc(s)+'</p>':'')+'</div>';}
function rest(){projects.hidden=false;results.hidden=true;results.innerHTML="";empty.hidden=true;more.hidden=true;}
function run(){
var w=words(q.value);
if(!w.length||q.value.trim().length<2){rest();return;}
if(idx.state===3){err.hidden=false;rest();return;}
if(!idx.data)return;
var hits=[];
for(var i=0;i<idx.data.length;i++){var it=idx.data[i],meta=(it.title+" "+it.ref+" "+it.project).toLowerCase(),text=String(it.text||"").toLowerCase(),ok=1,only=null;
for(var j=0;j<w.length;j++){var inM=meta.indexOf(w[j])>=0,inT=text.indexOf(w[j])>=0;if(!inM&&!inT){ok=0;break;}if(!inM&&!only)only=w[j];}
if(!ok)continue;
hits.push({it:it,s:only?snip(it.text,text.indexOf(only)):"",body:only?1:0});}
hits.sort(function(a,b){return a.body-b.body||rank(a.it.kind,a.it.status)-rank(b.it.kind,b.it.status)||(a.it.updated<b.it.updated?1:a.it.updated>b.it.updated?-1:a.it.title.localeCompare(b.it.title));});
projects.hidden=true;empty.hidden=hits.length>0;results.hidden=hits.length===0;
results.innerHTML=hits.slice(0,50).map(function(h){return row(h.it,h.s);}).join("");
more.hidden=hits.length<=50;more.textContent=(hits.length-50)+" more";}
q.addEventListener("input",function(){idx.load();run();});
})();
</script>`;
  return listShell("Intrface documents", body, script);
}

function projectPage(project: string, entries: Entry[], all: Entry[] = entries): string {
  const byRef = new Map(all.map((e) => [`${e.project}/${e.slug}`, e]));
  const row = (e: Entry) => {
    const mirrors = Object.keys(e.claude || {}).sort();
    const mirror = mirrors.length
      ? `<span class="mirror"><span class="k">claude.ai</span>${mirrors.map((a) => `<a href="${esc(e.claude![a])}">${esc(a)}</a>`).join("")}</span>`
      : "";
    const note = e.note ? `<p class="note">${esc(e.note)}</p>` : "";
    const search = esc(`${e.title} ${e.slug}`.toLowerCase());
    const old = isDecision(e) && statusOf(e) === "superseded";
    const kindBadge = isDecision(e) ? `<span class="badge kind">decision</span>` : "";
    const oldBadge = old ? `<span class="badge">superseded</span>` : "";
    const rep = old && e.supersededBy ? byRef.get(e.supersededBy) : undefined;
    const by = rep ? `<span class="by">superseded by <a href="/${rep.project}/${rep.slug}/">${esc(rep.title)}</a></span>` : "";
    return `<div class="row${old ? " old" : ""}" data-ref="${esc(`${e.project}/${e.slug}`)}" data-search="${search}"><a class="t" href="/${project}/${e.slug}/">${esc(e.title)}</a><span class="d">${esc(e.updated)}</span><span class="meta"><span class="slug">${esc(e.slug)}</span>${kindBadge}${oldBadge}<span class="badge ${e.visibility}">${e.visibility}</span>${by}${mirror}</span>${note}</div>`;
  };
  const decisions = [
    ...entries.filter(isActiveDecision).sort(byUpdatedDesc),
    ...entries.filter((e) => isDecision(e) && !isActiveDecision(e)).sort(byUpdatedDesc),
  ];
  const research = entries.filter((e) => !isDecision(e)).sort(byUpdatedDesc);
  const group = (heading: string, list: Entry[]) =>
    list.length ? `<section class="group">${heading ? `<h2 class="ghead">${heading}</h2>` : ""}<div class="list">${list.map(row).join("")}</div></section>` : "";
  const groups = decisions.length
    ? group("Decisions", decisions) + group("Research", research)
    : group("", research);
  const counts = [
    decisions.length ? plural(decisions.length, "decision") : "",
    research.length ? `${research.length} research` : "",
  ].filter(Boolean).join(" · ") || plural(entries.length, "page");
  const filter = `<div class="filter"><input id="q" type="search" autocomplete="off" aria-label="Search this project" placeholder="Search this project"></div>`;
  const script = `<script>
(function(){${SEARCH_JS}
var q=document.getElementById("q"),rows=[].slice.call(document.querySelectorAll(".row")),groups=[].slice.call(document.querySelectorAll(".group")),c=document.getElementById("count"),empty=document.getElementById("empty"),err=document.getElementById("err");
var idx=index(run),texts={};
function run(){
if(idx.state===2&&!texts.ready){texts.ready=1;for(var i=0;i<idx.data.length;i++){var d=idx.data[i];texts[d.ref]={t:String(d.text||""),l:String(d.text||"").toLowerCase()};}}
if(idx.state===3)err.hidden=false;
var w=words(q.value),n=0;
rows.forEach(function(r){
var hay=r.getAttribute("data-search"),tx=texts[r.getAttribute("data-ref")]||{t:"",l:""},ok=1,only=null;
for(var j=0;j<w.length;j++){var inM=hay.indexOf(w[j])>=0,inT=tx.l.indexOf(w[j])>=0;if(!inM&&!inT){ok=0;break;}if(!inM&&!only)only=w[j];}
r.hidden=!ok;if(ok)n++;
var old=r.querySelector(".snip");if(old)old.parentNode.removeChild(old);
if(ok&&only)r.insertAdjacentHTML("beforeend",'<p class="snip">'+esc(snip(tx.t,tx.l.indexOf(only)))+'</p>');});
groups.forEach(function(g){g.hidden=![].slice.call(g.querySelectorAll(".row")).some(function(r){return !r.hidden;});});
c.textContent=w.length?n+" of "+rows.length:c.getAttribute("data-all");empty.hidden=n>0;}
q.addEventListener("input",function(){idx.load();run();});run();})();
</script>`;
  const body = `<div class="top"><span class="crumb"><a href="/">All projects</a><span>›</span>${esc(project)}</span><a class="out" href="/_logout">Sign out</a></div>
<h1>${esc(project)}</h1>
<p class="count"><b id="count" data-all="${esc(counts)}">${esc(counts)}</b></p>
${filter}
${groups}
<p class="empty" id="empty" hidden>No page matches that text.</p>
<p class="empty" id="err" hidden>Search unavailable.</p>`;
  return listShell(`${project} — Intrface documents`, body, script);
}

function copyDir(src: string, dst: string) {
  mkdirSync(dst, { recursive: true });
  for (const name of readdirSync(src)) {
    if (name === ".DS_Store") continue;
    const s = join(src, name), d = join(dst, name);
    if (statSync(s).isDirectory()) copyDir(s, d);
    else copyFileSync(s, d);
  }
}

// ---------- commands ----------
function cmdInit() {
  mkdirSync(LIB, { recursive: true });
  if (!existsSync(manifestPath())) {
    saveManifest({ site: { ...DEFAULTS }, entries: [] });
    console.log(`created ${manifestPath()}`);
  }
  const gi = join(LIB, ".gitignore");
  if (!existsSync(gi)) writeFileSync(gi, "site/\n.DS_Store\n.wrangler/\n");
  if (!existsSync(join(LIB, ".git"))) spawnSync("git", ["init", "-q", "-b", "main"], { cwd: LIB, stdio: "inherit" });
  if (!existsSync(ENV_FILE)) {
    mkdirSync(dirname(ENV_FILE), { recursive: true });
    const secret = randomBytes(32).toString("hex");
    const password = randomBytes(9).toString("base64url");
    writeFileSync(ENV_FILE, `# artifact-pages: owner password for the docs site and the HMAC secret for share links.\n# Push to Cloudflare with: artifact-pages secrets\nDOCS_PASSWORD=${password}\nDOCS_SECRET=${secret}\n# Optional: a scoped API token (Pages edit). Without it the wrangler OAuth token is used.\n#CLOUDFLARE_API_TOKEN=\n`, { mode: 0o600 });
    console.log(`created ${ENV_FILE} with a new owner password and secret`);
  }
  console.log(`library: ${LIB}`);
}

function cmdAdd(args: string[]) {
  const title = flag(args, "--title");
  const from = flag(args, "--from");
  const visibility = (flag(args, "--visibility") as Entry["visibility"]) || "private";
  const kind = flag(args, "--kind") as Entry["kind"];
  const status = flag(args, "--status") as Entry["status"];
  const supersededBy = flag(args, "--superseded-by");
  const claudeUrl = flag(args, "--claude-url");
  const account = flag(args, "--account");
  const isDir = has(args, "--dir");
  const ref = args[0];
  if (!ref) die("usage: add <project>/<slug> --title \"...\" [--from <file|dir>] [--dir] [--visibility private|public] [--kind research|decision] [--status active|superseded] [--superseded-by <p>/<s>] [--claude-url URL --account NAME]");
  if (kind && !(KINDS as readonly string[]).includes(kind)) die(`--kind must be ${KINDS.join(" or ")}`);
  if (status && !(STATUSES as readonly string[]).includes(status)) die(`--status must be ${STATUSES.join(" or ")}`);
  if (supersededBy) parseRef(supersededBy);
  const [project, slug] = parseRef(ref);
  const m = loadManifest();
  let e = m.entries.find((x) => x.project === project && x.slug === slug);
  const dest = isDir ? join(LIB, project, slug) : join(LIB, project, `${slug}.html`);
  if (from) {
    mkdirSync(dirname(dest), { recursive: true });
    if (isDir) copyDir(resolve(from), dest);
    else {
      const raw = readFileSync(resolve(from), "utf8");
      writeFileSync(dest, stripWrapper(raw));
    }
  }
  if (!existsSync(dest)) die(`source missing: ${dest} (write the page body there, or pass --from)`);
  if (!e) {
    if (!title) die("--title is required for a new entry");
    e = { project, slug, title, visibility, updated: today() };
    if (isDir) e.type = "dir";
    m.entries.push(e);
  } else {
    if (title) e.title = title;
    if (args.includes("--visibility") || visibility !== "private") e.visibility = visibility;
    e.updated = today();
  }
  if (kind) e.kind = kind;
  if (status) e.status = status;
  if (supersededBy) e.supersededBy = supersededBy;
  if (claudeUrl) {
    e.claude = e.claude || {};
    e.claude[account || "unknown"] = claudeUrl;
  }
  saveManifest(m);
  console.log(`${e.title} -> ${urlFor(m, e)} (${e.visibility})`);
}

function writeIndexMd(m: Manifest) {
  const accounts = [...new Set(m.entries.flatMap((e) => Object.keys(e.claude || {})))].sort();
  const lines: string[] = [];
  lines.push(`# Artifact library`, ``, `Generated by \`artifact-pages build\` from manifest.json on ${today()}. Do not edit by hand.`, ``);
  lines.push(`Site: https://${m.site.host}/ (Cloudflare Pages project \`${m.site.project}\`). Every page is private unless marked public; share links come from \`artifact-pages share <project>/<slug>\`.`, ``);
  const projects = [...new Set(m.entries.map((e) => e.project))].sort();
  for (const p of projects) {
    lines.push(`## ${p}`, ``);
    lines.push(`| Page | Title | Kind | Status | Visibility | Updated |${accounts.map((a) => ` ${a} |`).join("")}`);
    lines.push(`|---|---|---|---|---|---|${accounts.map(() => "---|").join("")}`);
    for (const e of m.entries.filter((x) => x.project === p)) {
      const status = !isDecision(e) ? "—" : statusOf(e) === "superseded" ? `superseded → ${e.supersededBy || "?"}` : "active";
      lines.push(`| [${e.slug}](${urlFor(m, e)}) | ${e.title} | ${kindOf(e)} | ${status} | ${e.visibility} | ${e.updated} |${accounts.map((a) => ` ${e.claude?.[a] || "—"} |`).join("")}`);
    }
    lines.push(``);
  }
  writeFileSync(join(LIB, "INDEX.md"), lines.join("\n"));
}

function cmdBuild(): Manifest {
  const m = loadManifest();
  const site = join(LIB, "site");
  rmSync(site, { recursive: true, force: true });
  mkdirSync(join(site, "dist"), { recursive: true });
  copyDir(join(SKILL_DIR, "templates", "functions"), join(site, "functions"));
  const access: Record<string, string> = {};
  const byProject = new Map<string, Entry[]>();
  for (const e of m.entries) {
    const src = sourcePath(e);
    if (!existsSync(src)) die(`missing source for ${e.project}/${e.slug}: ${src}`);
    const out = join(site, "dist", e.project, e.slug);
    if (e.type === "dir") copyDir(src, out);
    else {
      mkdirSync(out, { recursive: true });
      writeFileSync(join(out, "index.html"), wrapBody(readFileSync(src, "utf8"), e.title));
    }
    access[`/${e.project}/${e.slug}/`] = e.visibility;
    byProject.set(e.project, [...(byProject.get(e.project) || []), e]);
  }
  for (const [p, entries] of byProject) {
    writeFileSync(join(site, "dist", p, "index.html"), projectPage(p, entries, m.entries));
  }
  writeFileSync(join(site, "dist", "index.html"), rootPage(m.site.host, byProject));
  writeFileSync(join(site, "dist", "_access.json"), JSON.stringify(access, null, 2));
  // Owner-only search index for the listing pages (gated like _access.json).
  const index = m.entries.map((e) => ({
    ref: `${e.project}/${e.slug}`,
    project: e.project,
    slug: e.slug,
    title: e.title,
    kind: kindOf(e),
    status: isDecision(e) ? statusOf(e) : undefined,
    updated: e.updated,
    visibility: e.visibility,
    url: `/${e.project}/${e.slug}/`,
    text: plainText(e).replace(/\s+/g, " ").trim().slice(0, 4000),
  }));
  writeFileSync(join(site, "dist", "_search.json"), JSON.stringify(index));
  writeFileSync(join(site, "dist", "_headers"), `/*\n  X-Robots-Tag: noindex\n  Referrer-Policy: same-origin\n  Cache-Control: no-store\n`);
  writeIndexMd(m);
  console.log(`built ${m.entries.length} pages into ${site}/dist`);
  return m;
}

function wrangler(args: string[], cwd: string): number {
  const r = spawnSync("bunx", [WRANGLER, ...args], { cwd, stdio: "inherit", env: { ...process.env, CLOUDFLARE_API_TOKEN: cfToken() } });
  return r.status ?? 1;
}

function cmdSecrets() {
  const m = loadManifest();
  const env = readEnvFile();
  for (const k of ["DOCS_SECRET", "DOCS_PASSWORD"]) {
    if (!env[k]) die(`${k} missing in ${ENV_FILE}`);
    const r = spawnSync("bunx", [WRANGLER, "pages", "secret", "put", k, "--project-name", m.site.project], {
      cwd: join(LIB, "site"), input: env[k], stdio: ["pipe", "inherit", "inherit"], env: { ...process.env, CLOUDFLARE_API_TOKEN: cfToken() },
    });
    if (r.status !== 0) die(`failed to set ${k}`);
  }
}

function cmdPublish(args: string[]) {
  const noCommit = has(args, "--no-commit");
  const msg = flag(args, "-m") || `publish ${today()}`;
  const m = cmdBuild();
  const site = join(LIB, "site");
  if (!existsSync(site)) die("build produced no site/");
  const code = wrangler(["pages", "deploy", "dist", "--project-name", m.site.project, "--branch", m.site.branch, "--commit-dirty=true"], site);
  if (code !== 0) die("deploy failed");
  if (!noCommit && existsSync(join(LIB, ".git"))) {
    spawnSync("git", ["add", "-A"], { cwd: LIB });
    const st = spawnSync("git", ["status", "--porcelain"], { cwd: LIB, encoding: "utf8" }).stdout.trim();
    if (st) spawnSync("git", ["commit", "-q", "-m", msg], { cwd: LIB, stdio: "inherit" });
  }
  console.log(`live: https://${m.site.host}/`);
}

function cmdShare(args: string[]) {
  const days = Number(flag(args, "--days") || "30");
  const ref = args[0];
  if (!ref) die("usage: share <project>/<slug> [--days N|0 for no expiry]");
  const m = loadManifest();
  const e = findEntry(m, ref);
  const env = readEnvFile();
  if (!env.DOCS_SECRET) die(`DOCS_SECRET missing in ${ENV_FILE}`);
  const prefix = `/${e.project}/${e.slug}/`;
  const exp = days > 0 ? Date.now() + days * 864e5 : 0;
  const sig = createHmac("sha256", env.DOCS_SECRET).update(`${prefix}|${exp}`).digest("hex").slice(0, 40);
  const token = Buffer.from(`${prefix}|${exp}|${sig}`).toString("base64url");
  console.log(`${urlFor(m, e)}?share=${token}`);
  if (exp) console.error(`expires ${new Date(exp).toISOString().slice(0, 10)}; rotate DOCS_SECRET to revoke all share links`);
}

function cmdVisibility(args: string[]) {
  const [ref, vis] = args;
  if (!ref || !["public", "private"].includes(vis)) die("usage: visibility <project>/<slug> public|private");
  const m = loadManifest();
  const e = findEntry(m, ref);
  e.visibility = vis as Entry["visibility"];
  e.updated = today();
  saveManifest(m);
  console.log(`${ref} is now ${vis}; run \`artifact-pages publish\` to apply`);
}

// A decision is marked by hand, never inferred: only these three commands move a
// page between the two kinds.
function cmdDecide(args: string[]) {
  const ref = args[0];
  if (!ref) die("usage: decide <project>/<slug>");
  const m = loadManifest();
  const e = findEntry(m, ref);
  e.kind = "decision";
  e.status = "active";
  delete e.supersededBy;
  e.updated = today();
  saveManifest(m);
  console.log(`${e.title} is now an active decision -> ${urlFor(m, e)}`);
}

function cmdSupersede(args: string[]) {
  const by = flag(args, "--by");
  const ref = args[0];
  if (!ref || !by) die("usage: supersede <project>/<slug> --by <project>/<slug>");
  const m = loadManifest();
  const e = findEntry(m, ref);
  if (!isDecision(e)) die(`${ref} is research, not a decision; run \`artifact-pages decide ${ref}\` first if it is one`);
  const rep = findEntry(m, by);
  if (rep === e) die(`${ref} cannot supersede itself`);
  e.status = "superseded";
  e.supersededBy = `${rep.project}/${rep.slug}`;
  e.updated = today();
  saveManifest(m);
  console.log(`${e.title} is superseded -> ${urlFor(m, e)}`);
  console.log(`replaced by ${rep.title} -> ${urlFor(m, rep)}`);
}

function cmdResearch(args: string[]) {
  const ref = args[0];
  if (!ref) die("usage: research <project>/<slug>");
  const m = loadManifest();
  const e = findEntry(m, ref);
  e.kind = "research";
  delete e.status;
  delete e.supersededBy;
  e.updated = today();
  saveManifest(m);
  console.log(`${e.title} is now research -> ${urlFor(m, e)}`);
}

function cmdUrl(args: string[]) {
  const m = loadManifest();
  console.log(urlFor(m, findEntry(m, args[0] || "")));
}
function cmdList() {
  const m = loadManifest();
  for (const e of m.entries) console.log(`${e.visibility.padEnd(7)} ${kindLabel(e).padEnd(21)} ${e.updated}  ${e.project}/${e.slug}  ${e.title}`);
}
// An agent reads a page here, not over HTTP: no browser, no login, no claude.ai.
function cmdShow(args: string[]) {
  const raw = has(args, "--raw");
  const maxArg = flag(args, "--max");
  const max = maxArg === undefined ? 60000 : Number(maxArg);
  const ref = args[0];
  if (!ref) die("usage: show <project>/<slug> [--raw] [--max N]  (0 = no limit)");
  if (!Number.isFinite(max) || max < 0) die("--max takes a character count (0 = no limit)");
  const m = loadManifest();
  const e = findEntry(m, ref);
  const src = bodyFile(e);
  if (!existsSync(src)) die(`missing source for ${e.project}/${e.slug}: ${src}`);
  if (raw) {
    process.stdout.write(readFileSync(src, "utf8"));
    return;
  }
  const { title, text } = htmlToText(readFileSync(src, "utf8"));
  const sup = isDecision(e) && statusOf(e) === "superseded" ? ` · superseded by ${e.supersededBy || "?"}` : "";
  const head = `# ${title || e.title}\n${e.project}/${e.slug} · ${kindOf(e)}${sup} · ${e.visibility} · updated ${e.updated} · ${urlFor(m, e)}`;
  const body = max > 0 && text.length > max
    ? `${text.slice(0, max)}\n… truncated (${text.length} chars); use --max 0 for all`
    : text;
  console.log(`${head}\n\n${body}`);
}

function snippet(text: string, at: number): string {
  const start = Math.max(0, at - 50);
  const cut = text.slice(start, start + 120).replace(/\s+/g, " ").trim();
  return `${start > 0 ? "…" : ""}${cut}${start + 120 < text.length ? "…" : ""}`;
}
function findRank(e: Entry): number {
  return isActiveDecision(e) ? 0 : isDecision(e) ? 1 : 2;
}

function cmdFind(args: string[]) {
  const project = flag(args, "--project");
  const onlyDecisions = has(args, "--decisions");
  const words = args.filter((a) => !a.startsWith("--")).map((w) => w.toLowerCase());
  if (!words.length) die("usage: find <words…> [--project <project>] [--decisions]");
  const m = loadManifest();
  const hits: { e: Entry; snip?: string }[] = [];
  for (const e of m.entries) {
    if (project && e.project !== project) continue;
    if (onlyDecisions && !isActiveDecision(e)) continue;
    const meta = `${e.title} ${e.slug} ${e.project} ${kindLabel(e)} ${e.note || ""}`.toLowerCase();
    const text = plainText(e);
    const low = text.toLowerCase();
    if (!words.every((w) => meta.includes(w) || low.includes(w))) continue;
    const bodyOnly = words.find((w) => !meta.includes(w) && low.includes(w));
    hits.push({ e, snip: bodyOnly ? snippet(text, low.indexOf(bodyOnly)) : undefined });
  }
  if (!hits.length) {
    console.log("no match");
    process.exit(1);
  }
  hits.sort((a, b) => findRank(a.e) - findRank(b.e) || byUpdatedDesc(a.e, b.e));
  const wRef = Math.max(...hits.map((h) => `${h.e.project}/${h.e.slug}`.length));
  const wKind = Math.max(...hits.map((h) => kindLabel(h.e).length));
  for (const h of hits) {
    console.log(`${`${h.e.project}/${h.e.slug}`.padEnd(wRef)}  ${kindLabel(h.e).padEnd(wKind)}  ${h.e.updated}  ${h.e.title}`);
    if (h.snip) console.log(`    ${h.snip}`);
  }
}

function cmdDecisions(args: string[]) {
  const all = has(args, "--all");
  const project = args[0];
  if (project && !/^[a-z0-9][a-z0-9-]*$/.test(project)) die(`bad project "${project}"; expected lowercase kebab-case`);
  const m = loadManifest();
  const list = m.entries
    .filter((e) => isDecision(e) && (all || statusOf(e) === "active"))
    .filter((e) => !project || e.project === project)
    .sort((a, b) => findRank(a) - findRank(b) || byUpdatedDesc(a, b));
  if (!list.length) {
    console.log(project ? `no decisions in ${project}` : "no decisions");
    return;
  }
  const line = (e: Entry) => {
    const sup = statusOf(e) === "superseded" ? ` (superseded by ${e.supersededBy || "?"})` : "";
    return `${e.project}/${e.slug}  ${e.updated}  ${e.title}${sup}  ${urlFor(m, e)}`;
  };
  if (project) {
    for (const e of list) console.log(line(e));
    return;
  }
  const projects = [...new Set(list.map((e) => e.project))].sort();
  projects.forEach((p, i) => {
    if (i) console.log("");
    console.log(p);
    for (const e of list.filter((e) => e.project === p)) console.log(`  ${line(e)}`);
  });
}

function cmdStrip(args: string[]) {
  const f = args[0];
  if (!f) die("usage: strip <raw-artifact.html> [> body.html]");
  process.stdout.write(stripWrapper(readFileSync(resolve(f), "utf8")));
}
function cmdOpen(args: string[]) {
  const m = loadManifest();
  const u = args[0] ? urlFor(m, findEntry(m, args[0])) : `https://${m.site.host}/`;
  spawnSync("open", [u]);
  console.log(u);
}

async function cfApi(path: string, init: RequestInit = {}, token = cfToken()): Promise<any> {
  const r = await fetch(`https://api.cloudflare.com/client/v4${path}`, {
    ...init,
    headers: { authorization: `Bearer ${token}`, "content-type": "application/json", ...(init.headers || {}) },
  });
  const d: any = await r.json();
  if (!d.success) throw new Error(`${path}: ${JSON.stringify(d.errors)}`);
  return d.result;
}

// Point the custom host at the Pages project: attach the domain, replace any
// stale DNS record on that name with a proxied CNAME to <project>.pages.dev,
// then report the verification state. Needs a token with Zone DNS edit.
async function cmdDomain() {
  const m = loadManifest();
  const host = m.site.host, project = m.site.project;
  const zoneName = host.split(".").slice(-2).join(".");
  const dns = cfDnsToken();
  const [zone] = await cfApi(`/zones?name=${zoneName}`, {}, dns);
  if (!zone) die(`zone ${zoneName} not on this account`);
  const accounts = await cfApi(`/accounts`);
  const account = accounts.find((a: any) => a.id === zone.account.id) || accounts[0];
  const domains = await cfApi(`/accounts/${account.id}/pages/projects/${project}/domains`);
  if (!domains.some((d: any) => d.name === host)) {
    await cfApi(`/accounts/${account.id}/pages/projects/${project}/domains`, { method: "POST", body: JSON.stringify({ name: host }) });
    console.log(`attached ${host} to ${project}`);
  }
  const target = `${project}.pages.dev`;
  const records = await cfApi(`/zones/${zone.id}/dns_records?name=${host}`, {}, dns);
  const ok = records.find((r: any) => r.type === "CNAME" && r.content === target);
  for (const r of records) {
    if (r === ok) continue;
    await cfApi(`/zones/${zone.id}/dns_records/${r.id}`, { method: "DELETE" }, dns);
    console.log(`removed stale ${r.type} ${r.name} -> ${r.content}`);
  }
  if (!ok) {
    await cfApi(`/zones/${zone.id}/dns_records`, { method: "POST", body: JSON.stringify({ type: "CNAME", name: host, content: target, proxied: true, ttl: 1, comment: "artifact-pages" }) }, dns);
    console.log(`created CNAME ${host} -> ${target}`);
  }
  for (let i = 0; i < 12; i++) {
    const d = await cfApi(`/accounts/${account.id}/pages/projects/${project}/domains/${host}`);
    console.log(`${host}: ${d.status} (verification ${d.verification_data?.status}, certificate ${d.validation_data?.status})`);
    if (d.status === "active") return;
    await new Promise((r) => setTimeout(r, 5000));
  }
  console.log("still pending; rerun `artifact-pages domain` in a few minutes");
}

const [cmd, ...rest] = process.argv.slice(2);
switch (cmd) {
  case "init": cmdInit(); break;
  case "add": cmdAdd(rest); break;
  case "build": cmdBuild(); break;
  case "publish": case "deploy": cmdPublish(rest); break;
  case "share": cmdShare(rest); break;
  case "visibility": cmdVisibility(rest); break;
  case "decide": cmdDecide(rest); break;
  case "supersede": cmdSupersede(rest); break;
  case "research": cmdResearch(rest); break;
  case "show": case "read": cmdShow(rest); break;
  case "find": cmdFind(rest); break;
  case "decisions": cmdDecisions(rest); break;
  case "url": cmdUrl(rest); break;
  case "list": cmdList(); break;
  case "strip": cmdStrip(rest); break;
  case "secrets": cmdSecrets(); break;
  case "open": cmdOpen(rest); break;
  case "domain":
    try { await cmdDomain(); } catch (e: any) {
      if (/Authentication error/.test(String(e?.message))) {
        console.error("Cloudflare refused the DNS call: the current token has no Zone DNS Edit scope.\nCreate an API token with Zone DNS Edit on intrface.eu and put it in " + ENV_FILE + " as CLOUDFLARE_DNS_TOKEN (or in the keychain as service cloudflare-dns-intrface), then rerun `artifact-pages domain`.\nAlternative: delete the stale `docs` DNS record in the Cloudflare dashboard, then rerun.");
        process.exit(2);
      }
      throw e;
    }
    break;
  default:
    console.log(`usage: artifact-pages <init|add|build|publish|share|visibility|decide|supersede|research|show|find|decisions|url|list|strip|secrets|open> ...
  init                                   create manifest, git repo, and ${ENV_FILE}
  add <p>/<s> --title T [--from F] [--dir] [--visibility V]
              [--kind research|decision] [--status active|superseded] [--superseded-by <p>/<s>]
              [--claude-url U --account A]
  build                                  manifest -> site/dist (+ INDEX.md)
  publish [-m msg] [--no-commit]         build, deploy to Cloudflare Pages, commit
  share <p>/<s> [--days N]               signed link for a private page (0 = no expiry)
  visibility <p>/<s> public|private      flip a page's visibility (then publish)
  decide <p>/<s>                         mark a page as a decision the team builds against
  supersede <p>/<s> --by <p>/<s>         retire a decision in favour of another one
  research <p>/<s>                       move a page back to research (the default kind)
  show <p>/<s> [--raw] [--max N]         print the page as plain text (alias: read)
  find <words…> [--project P] [--decisions]   search titles, slugs, notes and page text
  decisions [<project>] [--all]          active decisions, one line each with its URL
  url <p>/<s> | list | open [<p>/<s>]    lookups
  strip <raw.html>                       strip the claude.ai frame wrapper to stdout
  secrets                                push DOCS_SECRET and DOCS_PASSWORD to Pages
  domain                                 attach the custom host and fix its DNS (needs Zone DNS edit token)`);
    process.exit(cmd ? 1 : 0);
}
