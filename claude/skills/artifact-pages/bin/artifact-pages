#!/usr/bin/env bun
// artifact-pages: local artifact library -> private pages on Cloudflare Pages.
//
// Library layout (ARTIFACT_LIBRARY, default ~/dev/artifact-library):
//   manifest.json            registry: one entry per artifact
//   <project>/<slug>.html    authored page body (no doctype/html/head/body)
//   <project>/<slug>/        or a directory entry (multi-file page, index.html)
//   site/                    build output + functions/, deployed as-is
//   INDEX.md                 generated from the manifest
//
// Commands: init | add | build | publish | share | visibility | decide | supersede | research
//           | show | find | decisions | comments | reply | resolve | comment
//           | url | list | strip | secrets | domain | open

import { existsSync, mkdirSync, readFileSync, writeFileSync, readdirSync, statSync, copyFileSync, rmSync } from "node:fs";
import { join, dirname, basename, resolve } from "node:path";
import { homedir } from "node:os";
import { createHmac, randomBytes } from "node:crypto";
import { spawnSync } from "node:child_process";

const HOME = homedir();
const LIB = process.env.ARTIFACT_LIBRARY || join(HOME, "dev", "artifact-library");
const SKILL_DIR = resolve(dirname(Bun.main), "..");
const ENV_FILE = process.env.ARTIFACT_PAGES_ENV || join(HOME, ".config", "aoc", "artifact-pages.env");
// Pinned: unpinned `bunx wrangler` resolves to a build whose esbuild dependency is missing from bun's cache.
const WRANGLER = process.env.ARTIFACT_PAGES_WRANGLER || "wrangler@4.129.1";
// Site origin for the comments API; overridden when testing against a local run.
const BASE_OVERRIDE = (process.env.ARTIFACT_PAGES_BASE || "").replace(/\/+$/, "");
const DEFAULTS = { project: "intrface-docs", host: "docs.intrface.eu", branch: "main" };

type Entry = {
  project: string;
  slug: string;
  title: string;
  type?: "file" | "dir";
  visibility: "private" | "public";
  // research (the default) = surveys, scans, studies, audits: informational, may be
  // superseded, nobody builds on it. decision = briefs, specs, plans, charters the
  // team builds against; marked deliberately with `decide`, never inferred.
  kind?: "research" | "decision";
  status?: "active" | "superseded"; // decisions only; absent means active
  supersededBy?: string; // <project>/<slug> of the decision that replaced this one
  updated: string;
  claude?: Record<string, string>; // account -> claude.ai artifact URL
  note?: string;
};
const KINDS = ["research", "decision"] as const;
const STATUSES = ["active", "superseded"] as const;
type Manifest = { site: { project: string; host: string; branch: string }; entries: Entry[] };

function die(msg: string): never {
  console.error(`artifact-pages: ${msg}`);
  process.exit(1);
}
function today(): string {
  return new Date().toISOString().slice(0, 10);
}
function readEnvFile(): Record<string, string> {
  const out: Record<string, string> = {};
  if (!existsSync(ENV_FILE)) return out;
  for (const line of readFileSync(ENV_FILE, "utf8").split("\n")) {
    const m = line.match(/^\s*([A-Z_]+)\s*=\s*(.*)\s*$/);
    if (m) out[m[1]] = m[2].replace(/^["']|["']$/g, "");
  }
  return out;
}
function cfToken(): string {
  const env = readEnvFile();
  if (process.env.CLOUDFLARE_API_TOKEN) return process.env.CLOUDFLARE_API_TOKEN;
  if (env.CLOUDFLARE_API_TOKEN) return env.CLOUDFLARE_API_TOKEN;
  // Fall back to wrangler's OAuth token (works as a bearer token); refresh it
  // in place when it has expired, the same way wrangler does on each run.
  const cfg = join(HOME, "Library", "Preferences", ".wrangler", "config", "default.toml");
  const alt = join(HOME, ".wrangler", "config", "default.toml");
  for (const f of [cfg, alt]) {
    if (!existsSync(f)) continue;
    let text = readFileSync(f, "utf8");
    const tok = text.match(/^oauth_token\s*=\s*"([^"]+)"/m)?.[1];
    const ref = text.match(/^refresh_token\s*=\s*"([^"]+)"/m)?.[1];
    const exp = text.match(/^expiration_time\s*=\s*"([^"]+)"/m)?.[1];
    if (!tok) continue;
    if (!ref || !exp || Date.parse(exp) - Date.now() > 60_000) return tok;
    const body = new URLSearchParams({ grant_type: "refresh_token", refresh_token: ref, client_id: "54d11594-84e4-41aa-b438-e81b8fa78ee7" }).toString();
    const r = Bun.spawnSync(["curl", "-s", "-X", "POST", "https://dash.cloudflare.com/oauth2/token", "-H", "content-type: application/x-www-form-urlencoded", "--data", body]);
    let j: any = {};
    try { j = JSON.parse(r.stdout.toString()); } catch {}
    if (!j.access_token) die("wrangler OAuth token expired and refresh failed (" + (j.error_description || j.error || "no response") + "): run `bunx wrangler login`, or set CLOUDFLARE_API_TOKEN in " + ENV_FILE);
    const expIso = new Date(Date.now() + (j.expires_in || 3600) * 1000).toISOString();
    text = text.replace(/^oauth_token\s*=.*$/m, `oauth_token = "${j.access_token}"`)
      .replace(/^expiration_time\s*=.*$/m, `expiration_time = "${expIso}"`);
    if (j.refresh_token) text = text.replace(/^refresh_token\s*=.*$/m, `refresh_token = "${j.refresh_token}"`);
    writeFileSync(f, text, { mode: 0o600 });
    return j.access_token;
  }
  die("no Cloudflare token: set CLOUDFLARE_API_TOKEN in " + ENV_FILE + " or run `bunx wrangler login`");
}
// Zone DNS calls use a separate token when one exists: CLOUDFLARE_DNS_TOKEN
// (env or env file), else the macOS keychain item "cloudflare-dns-intrface"
// (zone-scoped DNS edit on intrface.eu, no Pages scope), else the general token.
function cfDnsToken(): string {
  const env = readEnvFile();
  const t = process.env.CLOUDFLARE_DNS_TOKEN || env.CLOUDFLARE_DNS_TOKEN;
  if (t) return t;
  const svc = env.CLOUDFLARE_DNS_KEYCHAIN || "cloudflare-dns-intrface";
  const r = Bun.spawnSync(["security", "find-generic-password", "-s", svc, "-w"]);
  if (r.exitCode === 0) { const k = r.stdout.toString().trim(); if (k) return k; }
  return cfToken();
}
function manifestPath(): string {
  return join(LIB, "manifest.json");
}
function loadManifest(): Manifest {
  if (!existsSync(manifestPath())) die(`no manifest at ${manifestPath()}; run \`artifact-pages init\``);
  return JSON.parse(readFileSync(manifestPath(), "utf8"));
}
function saveManifest(m: Manifest) {
  m.entries.sort((a, b) => a.project.localeCompare(b.project) || a.slug.localeCompare(b.slug));
  writeFileSync(manifestPath(), JSON.stringify(m, null, 2) + "\n");
}
function parseRef(ref: string): [string, string] {
  const m = ref.match(/^([a-z0-9][a-z0-9-]*)\/([a-z0-9][a-z0-9-]*)$/);
  if (!m) die(`bad reference "${ref}"; expected <project>/<slug> in lowercase kebab-case`);
  return [m[1], m[2]];
}
function findEntry(m: Manifest, ref: string): Entry {
  const [project, slug] = parseRef(ref);
  const e = m.entries.find((x) => x.project === project && x.slug === slug);
  if (!e) die(`no entry ${ref} in manifest`);
  return e;
}
function kindOf(e: Entry): "research" | "decision" {
  return e.kind === "decision" ? "decision" : "research";
}
function statusOf(e: Entry): "active" | "superseded" {
  return e.status === "superseded" ? "superseded" : "active";
}
function isDecision(e: Entry): boolean {
  return kindOf(e) === "decision";
}
function isActiveDecision(e: Entry): boolean {
  return isDecision(e) && statusOf(e) === "active";
}
function kindLabel(e: Entry): string {
  if (!isDecision(e)) return "research";
  return statusOf(e) === "superseded" ? "decision (superseded)" : "decision";
}
function urlFor(m: Manifest, e: Entry): string {
  return `https://${m.site.host}/${e.project}/${e.slug}/`;
}
function sourcePath(e: Entry): string {
  return e.type === "dir" ? join(LIB, e.project, e.slug) : join(LIB, e.project, `${e.slug}.html`);
}
function flag(args: string[], name: string): string | undefined {
  const i = args.indexOf(name);
  if (i < 0) return undefined;
  const v = args[i + 1];
  args.splice(i, 2);
  return v;
}
function has(args: string[], name: string): boolean {
  const i = args.indexOf(name);
  if (i < 0) return false;
  args.splice(i, 1);
  return true;
}
function esc(s: string): string {
  return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
}

// ---------- html -> plain text ----------
// Enough of an HTML reader for an agent to read a page without a browser: headings,
// lists, tables, links and code survive; presentation is dropped.
const NAMED_ENTITIES: Record<string, string> = {
  amp: "&", lt: "<", gt: ">", quot: '"', apos: "'", "#39": "'", nbsp: " ", ensp: " ", emsp: " ", thinsp: " ",
  hellip: "…", mdash: "—", ndash: "–", minus: "−", times: "×", middot: "·", bull: "•", deg: "°",
  lsquo: "‘", rsquo: "’", ldquo: "“", rdquo: "”", laquo: "«", raquo: "»",
  euro: "€", pound: "£", copy: "©", reg: "®", trade: "™", larr: "←", rarr: "→", uarr: "↑", darr: "↓", check: "✓",
};
const BLOCK_TAGS = "p|div|section|article|header|footer|main|nav|aside|blockquote|figure|figcaption|ul|ol|dl|dt|dd|table|thead|tbody|tfoot|caption|form|fieldset|details|summary|hr";

function decodeEntities(s: string): string {
  return s.replace(/&(#x[0-9a-f]+|#[0-9]+|[a-z][a-z0-9]*);/gi, (full, g: string) => {
    if (g[0] === "#") {
      const n = g[1] === "x" || g[1] === "X" ? parseInt(g.slice(2), 16) : parseInt(g.slice(1), 10);
      return Number.isFinite(n) && n > 0 ? String.fromCodePoint(n) : full;
    }
    const hit = NAMED_ENTITIES[g.toLowerCase()];
    return hit === undefined ? full : hit;
  });
}
function stripTags(s: string): string {
  return s.replace(/<[^>]*>/g, "");
}

function htmlToText(html: string): { title?: string; text: string } {
  let s = html;
  let title: string | undefined;
  const tm = s.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
  if (tm) {
    title = decodeEntities(stripTags(tm[1])).replace(/\s+/g, " ").trim();
    s = s.replace(tm[0], "");
  }
  s = s.replace(/<(style|script|svg|noscript|template)\b[^>]*>[\s\S]*?<\/\1>/gi, "");
  s = s.replace(/<(style|script|svg|noscript|template)\b[^>]*\/>/gi, "");
  s = s.replace(/<!--[\s\S]*?-->/g, "");
  const fences: string[] = [];
  s = s.replace(/<pre\b[^>]*>([\s\S]*?)<\/pre>/gi, (_m, inner: string) => {
    fences.push("\n```\n" + decodeEntities(stripTags(inner)).replace(/^\n+|\s+$/g, "") + "\n```\n");
    return `␀${fences.length - 1}␀`;
  });
  s = s.replace(/<code\b[^>]*>([\s\S]*?)<\/code>/gi, (_m, inner: string) => "`" + decodeEntities(stripTags(inner)).replace(/\s+/g, " ").trim() + "`");
  s = s.replace(/<a\b[^>]*\bhref\s*=\s*("([^"]*)"|'([^']*)'|([^\s>]+))[^>]*>([\s\S]*?)<\/a>/gi,
    (_m, _q, dq: string, sq: string, bare: string, inner: string) => {
      const href = decodeEntities((dq ?? sq ?? bare ?? "").trim());
      const text = decodeEntities(stripTags(inner)).replace(/\s+/g, " ").trim();
      return /^https?:\/\//i.test(href) ? `${text} (${href})` : text;
    });
  s = s.replace(/<br\s*\/?>/gi, "\n");
  s = s.replace(/<h([1-6])\b[^>]*>/gi, (_m, n: string) => `\n\n${"#".repeat(Number(n))} `);
  s = s.replace(/<\/h[1-6]>/gi, "\n\n");
  s = s.replace(/<li\b[^>]*>/gi, "\n- ");
  s = s.replace(/<\/li>/gi, ""); // the next <li> or the list close already breaks the line
  s = s.replace(/<\/t[dh]>/gi, " | ");
  s = s.replace(/<\/?tr\b[^>]*>/gi, "\n");
  s = s.replace(new RegExp(`</?(?:${BLOCK_TAGS})\\b[^>]*>`, "gi"), "\n");
  s = decodeEntities(stripTags(s));
  s = s.split("\n").map((l) => l.replace(/[ \t ]+/g, " ").replace(/\s*\|\s*$/, "").trim()).join("\n");
  s = s.replace(/\n{3,}/g, "\n\n").trim();
  const lines = s.split("\n"); // source newlines between <li>s would otherwise space the list out
  s = lines.filter((l, i) => !(l === "" && lines[i - 1]?.startsWith("- ") && lines[i + 1]?.startsWith("- "))).join("\n");
  return { title, text: s.replace(/␀(\d+)␀/g, (_m, i: string) => fences[Number(i)]) };
}

function bodyFile(e: Entry): string {
  return e.type === "dir" ? join(sourcePath(e), "index.html") : sourcePath(e);
}
function readBody(e: Entry): string {
  const p = bodyFile(e);
  return existsSync(p) ? readFileSync(p, "utf8") : "";
}
function plainText(e: Entry): string {
  return htmlToText(readBody(e)).text;
}

// ---------- wrapping ----------
const HEAD_RESET = `<style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style>`;

export function stripWrapper(raw: string): string {
  const m = raw.match(/<\/head><body>\n?([\s\S]*)<\/body><\/html>\s*$/);
  return m ? m[1] : raw;
}
// `ref` ("<project>/<slug>") turns on the review-comment layer; listing pages
// and directory entries are served without it.
function wrapBody(body: string, fallbackTitle: string, ref = ""): string {
  let title = fallbackTitle;
  const tm = body.match(/<title>([\s\S]*?)<\/title>/i);
  if (tm) {
    title = tm[1].trim();
    body = body.replace(tm[0], "");
  }
  const mermaid = /class="mermaid"/.test(body)
    ? `<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/11.4.1/mermaid.min.js"></script><script>mermaid.initialize({startOnLoad:true})</script>`
    : "";
  const comments = ref
    ? `<link rel="stylesheet" href="/_comments.css"><script src="/_comments.js" data-page="${esc(ref)}" defer></script>`
    : "";
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title>${HEAD_RESET}</head><body>\n${body}\n${mermaid}${comments}</body></html>\n`;
}

